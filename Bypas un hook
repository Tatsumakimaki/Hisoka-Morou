local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local function TeamIs(plr, role)
    if not plr or not plr.Team or not plr.Team.Name then return false end
    local tn = string.lower(plr.Team.Name)
    if role == "Killer" then return string.find(tn, "killer", 1, true) ~= nil end
    if role == "Survivor" then return string.find(tn, "survivor", 1, true) ~= nil end
    return false
end

local function GB_GetAllGenerators()
    local gens = {}
    local mf = Workspace:FindFirstChild("Map")
    if mf then
        for _, obj in ipairs(mf:GetDescendants()) do
            if obj:IsA("Model") and obj.Name == "Generator" then
                local real = obj:GetAttribute("RepairProgress") ~= nil or obj:GetAttribute("kickcount") ~= nil or obj:GetAttribute("ProgressRepair") ~= nil
                if real then table.insert(gens, obj) end
            end
        end
    end
    return gens
end

local function GB_GetPoints(genModel)
    local pts = {}
    if genModel then
        for _, o in ipairs(genModel:GetChildren()) do
            if o:IsA("BasePart") and string.find(o.Name, "GeneratorPoint") then table.insert(pts, o) end
        end
    end
    return pts
end

local function SU_IsHooked()
    local char = LocalPlayer.Character
    if not char then return false end
    return char:GetAttribute("IsHooked") == true or char:GetAttribute("isHooked") == true or char:GetAttribute("Hooked") == true or char:GetAttribute("HookedState") == true
end

local function SU_GetRandomGeneratorPoint()
    local gens = GB_GetAllGenerators()
    if not gens or #gens == 0 then return nil end
    local valid = {}
    for _, g in ipairs(gens) do
        if g and g.Parent then
            for _, p in ipairs(GB_GetPoints(g)) do
                if p and p.Parent then table.insert(valid, p) end
            end
        end
    end
    if #valid == 0 then return nil end
    return valid[math.random(1, #valid)]
end

local function SU_GetKillerHRP()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and TeamIs(p, "Killer") and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            if hrp then return hrp end
        end
    end
    return nil
end

-- Setup Global State agar thread bisa dihentikan
_G.SU_State = _G.SU_State or {
    Following = false,
    _activeThread = nil,
    _lastTrigger = 0,
    _wasHooked = false
}

local function SU_Abort()
    _G.SU_State.Following = false
    if _G.SU_State._activeThread then
        pcall(function() task.cancel(_G.SU_State._activeThread) end)
        _G.SU_State._activeThread = nil
    end
end

local function SU_Trigger()
    if _G.SU_State.Following then return end
    local now = tick()
    if now - _G.SU_State._lastTrigger < 3 then return end
    if not SU_IsHooked() then return end

    _G.SU_State._lastTrigger = now
    _G.SU_State.Following = true

    local char = LocalPlayer.Character
    local hookPos, hookCFrame
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then hookPos = hrp.Position; hookCFrame = hrp.CFrame end
    end

    _G.SU_State._activeThread = task.spawn(function()
        local c = LocalPlayer.Character
        if not c then SU_Abort(); return end
        local hrp = c:FindFirstChild("HumanoidRootPart")
        if not hrp then SU_Abort(); return end

        local re = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("Generator") and ReplicatedStorage.Remotes.Generator:FindFirstChild("RepairEvent")

        if not SU_IsHooked() then SU_Abort(); return end

        local tp = SU_GetRandomGeneratorPoint()
        if tp then
            pcall(function() hrp.Velocity = Vector3.zero; hrp.CFrame = tp.CFrame + Vector3.new(0, 3, 0) end)
            task.wait(0.15)
            if re then
                pcall(function() re:FireServer(tp, true) end); task.wait(0.35)
                pcall(function() re:FireServer(tp, false) end); task.wait(0.15)
                pcall(function() re:FireServer(tp, true) end); task.wait(0.35)
                pcall(function() re:FireServer(tp, false) end)
            end
        end

        local fUntil = tick() + 30
        local bOff = 20

        while tick() < fUntil and _G.Miyako_BypassUnhook do
            if not SU_IsHooked() then break end
            local cc = LocalPlayer.Character
            if not cc then break end
            local r = cc:FindFirstChild("HumanoidRootPart")
            if not r then break end

            local khrp = SU_GetKillerHRP()
            if khrp then
                pcall(function()
                    r.Velocity = Vector3.zero
                    local tPos = Vector3.new(khrp.Position.X, khrp.Position.Y - bOff, khrp.Position.Z)
                    r.CFrame = CFrame.new(tPos, tPos + Vector3.new(0, 0, -1))
                end)
            end
            task.wait(0.03)
        end

        if SU_IsHooked() and _G.Miyako_BypassUnhook then
            local c2 = LocalPlayer.Character
            if c2 then
                local r2 = c2:FindFirstChild("HumanoidRootPart")
                if r2 then
                    if hookCFrame then pcall(function() r2.Velocity = Vector3.zero; r2.CFrame = hookCFrame end)
                    elseif hookPos then pcall(function() r2.Velocity = Vector3.zero; r2.CFrame = CFrame.new(hookPos + Vector3.new(0, 3, 0)) end) end
                end
            end
        end
        SU_Abort()
    end)
end

-- Hapus loop lama kalau file di-load ulang
if _G.Miyako_UnhookLoop then _G.Miyako_UnhookLoop:Disconnect() end

_G.Miyako_UnhookLoop = RunService.Heartbeat:Connect(function()
    -- BERHENTI SECARA TOTAL JIKA TOGGLE DI GUI DIMATIKAN
    if not _G.Miyako_BypassUnhook then
        SU_Abort()
        _G.SU_State._wasHooked = false
        return
    end

    local char = LocalPlayer.Character
    if not char then return end
    local isH = SU_IsHooked()
    
    if not isH then 
        _G.SU_State._wasHooked = false
        return 
    end
    
    if not _G.SU_State._wasHooked and not _G.SU_State.Following then
        _G.SU_State._wasHooked = true
        SU_Trigger()
    end
end)
