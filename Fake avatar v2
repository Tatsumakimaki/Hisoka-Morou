local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- Simpan state di _G agar tidak ter-reset saat dropdown diganti
_G.Miyako_OrigAvatarDesc = _G.Miyako_OrigAvatarDesc or nil
_G.Miyako_FakeAvatarLoaded = _G.Miyako_FakeAvatarLoaded or false

local PRESET_IDS = {
    ["Purple King"]         = 1283674681,
    ["Korblox"]             = 13416518,
    ["Headless"]            = 261,
    ["Dominus Flex"]        = 5312389,
    ["Valkyrie Helm"]       = 16138964,
    ["Slender"]             = 1714589254,
    ["Stitchface"]          = 156828551,
    ["Super Happy Face"]    = 246524956,
    ["E-Boy Aesthetic"]     = 1856382941,
    ["E-Girl Aesthetic"]    = 1928472911,
    ["Hacker / Anonymous"]  = 138128374,
    ["Guest 666"]           = 1845187,
    ["Classic Noob"]        = 156,
    ["Bacon Hair"]          = 1619854747,
    ["Anime Style"]         = 2394819281,
    ["Self Avatar"]         = LocalPlayer.UserId
}

local function getHumanoid()
    local char = LocalPlayer.Character
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function clearAccessories(char)
    for _, item in ipairs(char:GetDescendants()) do
        if item:IsA("Accessory") or item:IsA("Clothing") or item:IsA("ShirtGraphic") then
            pcall(function() item:Destroy() end)
        end
    end
end

local function applyTargetAvatar(userId)
    local hum = getHumanoid()
    local char = LocalPlayer.Character
    if not hum or not char then return end

    -- Hanya simpan avatar asli jika belum pernah disimpan
    if not _G.Miyako_OrigAvatarDesc then
        pcall(function() _G.Miyako_OrigAvatarDesc = hum:GetAppliedDescription() end)
    end

    task.spawn(function()
        local success, desc = pcall(function()
            return Players:GetHumanoidDescriptionFromUserId(userId)
        end)

        if success and desc then
            clearAccessories(char)
            task.wait(0.1)
            -- Eksekusi ganda agar 100% tembus di executor apapun
            pcall(function() hum:ApplyDescriptionClientServer(desc) end)
            pcall(function() hum:ApplyDescription(desc) end) 
        end
    end)
end

local function restoreOriginal()
    local hum = getHumanoid()
    local char = LocalPlayer.Character
    if hum and char and _G.Miyako_OrigAvatarDesc then
        clearAccessories(char)
        task.wait(0.1)
        pcall(function() hum:ApplyDescriptionClientServer(_G.Miyako_OrigAvatarDesc) end)
        pcall(function() hum:ApplyDescription(_G.Miyako_OrigAvatarDesc) end)
    end
end

-- Fungsi Utama yang dihubungkan ke GUI
_G.Miyako_UpdateFakeAvatar = function()
    if not _G.Miyako_FakeAvatarConfig or not _G.Miyako_FakeAvatarConfig.Enabled then
        restoreOriginal()
        return
    end
    
    local userTarget = _G.Miyako_FakeAvatarConfig.TargetUsername
    if userTarget and userTarget ~= "" then
        task.spawn(function()
            local s, id = pcall(function() return Players:GetUserIdFromNameAsync(userTarget) end)
            if s and id then applyTargetAvatar(id) end
        end)
        return
    end
    
    local preset = _G.Miyako_FakeAvatarConfig.Preset or "Purple King"
    local presetId = PRESET_IDS[preset]
    if presetId then applyTargetAvatar(presetId) end
end

-- Mencegah bug respawn berlapis
if not _G.Miyako_FakeAvatarLoaded then
    _G.Miyako_FakeAvatarLoaded = true
    LocalPlayer.CharacterAdded:Connect(function()
        task.wait(1)
        if _G.Miyako_UpdateFakeAvatar then _G.Miyako_UpdateFakeAvatar() end
    end)
end

-- Langsung panggil saat di-load
_G.Miyako_UpdateFakeAvatar()
