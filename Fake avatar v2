local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

_G.Miyako_FakeAvatarConfig = _G.Miyako_FakeAvatarConfig or {
    Enabled = false,
    Preset = "Purple King",
    TargetUsername = ""
}

-- Koleksi Lengkap Preset Avatar (User ID Outfit Asli)
local PRESET_IDS = {
    ["Purple King"]         = 1283674681, -- Outfit Purple King Stylized
    ["Korblox"]             = 13416518,   -- Korblox Deathspeaker
    ["Headless"]            = 261,        -- Headless Horseman User
    ["Dominus Flex"]        = 5312389,    -- Linkmon99 / Dominus Rich
    ["Valkyrie Helm"]       = 16138964,   -- Valkyrie Aesthetic
    ["Slender"]             = 1714589254, -- Slender Boy Style
    ["Stitchface"]          = 156828551,  -- Stitchface Gang Style
    ["Super Happy Face"]    = 246524956,  -- SSHF Rich Girl/Boy
    ["E-Boy Aesthetic"]     = 1856382941, -- E-Boy Style
    ["E-Girl Aesthetic"]    = 1928472911, -- E-Girl Style
    ["Hacker / Anonymous"]  = 138128374,  -- Black Hoodie / Mask
    ["Guest 666"]           = 1845187,    -- Creepy Red Guest
    ["Classic Noob"]        = 156,        -- Classic Yellow/Blue Noob
    ["Bacon Hair"]          = 1619854747, -- Bacon Boy
    ["Anime Style"]         = 2394819281, -- Stylized Anime Character
    ["Self Avatar"]         = LocalPlayer.UserId
}

local OriginalDescription = nil
local CurrentLoadedId = nil

local function getHumanoid()
    local char = LocalPlayer.Character
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function saveOriginal()
    local hum = getHumanoid()
    if hum and not OriginalDescription then
        pcall(function()
            OriginalDescription = hum:GetAppliedDescription()
        end)
    end
end

local function clearAccessories(char)
    for _, item in ipairs(char:GetDescendants()) do
        if item:IsA("Accessory") or item:IsA("Clothing") or item:IsA("ShirtGraphic") then
            pcall(function() item:Destroy() end)
        end
    end
end

local function applyTargetDescription(userId)
    if not userId then return end
    local hum = getHumanoid()
    local char = LocalPlayer.Character
    if not hum or not char then return end

    saveOriginal()
    CurrentLoadedId = userId

    task.spawn(function()
        local success, desc = pcall(function()
            return Players:GetHumanoidDescriptionFromUserId(userId)
        end)

        if success and desc then
            clearAccessories(char)
            task.wait(0.08)
            pcall(function()
                hum:ApplyDescriptionClientServer(desc)
            end)
        end
    end)
end

local function restoreOriginal()
    local hum = getHumanoid()
    local char = LocalPlayer.Character
    if hum and char and OriginalDescription then
        clearAccessories(char)
        task.wait(0.08)
        pcall(function()
            hum:ApplyDescriptionClientServer(OriginalDescription)
            CurrentLoadedId = nil
        end)
    end
end

local function updateAvatar()
    if not _G.Miyako_FakeAvatarConfig.Enabled then
        restoreOriginal()
        return
    end

    -- 1. Cek Via Username
    local userTarget = _G.Miyako_FakeAvatarConfig.TargetUsername
    if userTarget and userTarget ~= "" then
        task.spawn(function()
            local success, targetId = pcall(function()
                return Players:GetUserIdFromNameAsync(userTarget)
            end)
            if success and targetId then
                applyTargetDescription(targetId)
            end
        end)
        return
    end

    -- 2. Cek Preset Dropdown
    local selectedPreset = _G.Miyako_FakeAvatarConfig.Preset or "Purple King"
    local presetId = PRESET_IDS[selectedPreset]
    if presetId then
        applyTargetDescription(presetId)
    end
end

-- Hook saat respawn karakter
LocalPlayer.CharacterAdded:Connect(function()
    task.wait(0.8)
    if _G.Miyako_FakeAvatarConfig.Enabled and CurrentLoadedId then
        applyTargetDescription(CurrentLoadedId)
    end
end)

updateAvatar()
