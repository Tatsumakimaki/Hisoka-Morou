_G.Miyako_FakeAvatarConfig = _G.Miyako_FakeAvatarConfig or {
    Enabled = false,
    Preset = "Purple King",
    TargetUsername = ""
}

local function loadFakeAvatarV2Module()
    task.spawn(function()
        pcall(function()
            local url = "https://raw.githubusercontent.com/Tatsumakimaki/Hisoka-Morou/refs/heads/master/Fake%20avatar%20v2"
            local fn = loadstring(game:HttpGet(url))
            if fn then fn() end
        end)
    end)
end

Boxes.FakeAvatarV2:AddDropdown("FakeAvatarPreset", {
    Text = "Fake Avatar Preset",
    Values = {
        "Self Avatar", "WoozyNate", "Nicholas", "yvlyf", "traevp", "J0LLY",
        "LucashDev", "CEOofIsaac", "Stealthy", "Wildes", "Talon", "Relukt",
        "Sammy", "Diesel", "S4ans03", "Aura", "iJava", "White Guy",
        "Purple King", "Kachaaaa Gay", "Mpruyyy",
        "Random 1", "Random 2", "Random 3", "Random 4", "Random 5", "Random 6", "Random 7"
    },
    Default = 19, -- Default terpilih: "Purple King"
    Multi = false,
    Callback = function(val)
        _G.Miyako_FakeAvatarConfig.Preset = val
        if _G.Miyako_FakeAvatarConfig.Enabled then
            if _G.Miyako_ApplyFakeAvatar then
                _G.Miyako_ApplyFakeAvatar()
            else
                loadFakeAvatarV2Module()
            end
        end
    end
})

Boxes.FakeAvatarV2:AddCheckbox("EnableFakeAvatar", {
    Text = "Enable Fake Avatar",
    Default = false,
    Callback = function(v)
        _G.Miyako_FakeAvatarConfig.Enabled = v
        if v then
            if _G.Miyako_ApplyFakeAvatar then
                _G.Miyako_ApplyFakeAvatar()
            else
                loadFakeAvatarV2Module()
            end
        else
            -- Kembalikan karakter jika toggle dimatikan
            local char = LocalPlayer.Character
            if char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then
                    pcall(function()
                        local app = Players:GetCharacterAppearanceAsync(LocalPlayer.UserId)
                        if app then
                            for _, obj in pairs(char:GetChildren()) do
                                if obj:IsA("Accessory") or obj:IsA("Shirt") or obj:IsA("Pants")
                                or obj:IsA("BodyColors") or obj:IsA("CharacterMesh") or obj:IsA("ShirtGraphic") then
                                    obj:Destroy()
                                end
                            end
                        end
                    end)
                end
            end
        end
    end
})

Boxes.FakeAvatarV2:AddInput("FakeAvatarUsername", {
    Text = "Fake Avatar Via Username",
    Default = "",
    Placeholder = "username (tanpa @)",
    Callback = function(val)
        _G.Miyako_FakeAvatarConfig.TargetUsername = val
        if _G.Miyako_FakeAvatarConfig.Enabled then
            if _G.Miyako_ApplyFakeAvatar then
                _G.Miyako_ApplyFakeAvatar()
            else
                loadFakeAvatarV2Module()
            end
        end
    end
})
