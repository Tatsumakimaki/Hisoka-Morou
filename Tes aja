ParryBox:AddCheckbox("ShowParryRange", {
    Text = "Show Parry Range",
    Default = true,
    Callback = function(Value)
        ParryRangeVisual.Enabled = Value
        if not Value and ParryCircle then
            ParryCircle:Destroy()
            ParryCircle = nil
        end
    end
})
ParryBox:AddCheckbox("AggressiveParry", {
    Text = "Aggressive Parry",
    Default = false,
    Callback = function(v)
        Auto.AggressiveParry = v
        if v then
            Auto.SavedDistance = Auto.ParryDistance
            Auto.SavedFaceSensitivity = Auto.FaceSensitivity

            Auto.IsUpdatingSlider = true
            if ParryDistanceSlider and ParryDistanceSlider.SetValue then
                ParryDistanceSlider:SetValue(11)
            end
            if FaceSensitivitySlider and FaceSensitivitySlider.SetValue then
                FaceSensitivitySlider:SetValue(0.40)
            end
            Auto.ParryDistance = 11
            Auto.FaceSensitivity = 0.40
            Auto.IsUpdatingSlider = false
        else
            Auto.IsUpdatingSlider = true
            if ParryDistanceSlider and ParryDistanceSlider.SetValue and Auto.SavedDistance then
                ParryDistanceSlider:SetValue(Auto.SavedDistance)
                Auto.ParryDistance = Auto.SavedDistance
            end
            if FaceSensitivitySlider and FaceSensitivitySlider.SetValue and Auto.SavedFaceSensitivity then
                FaceSensitivitySlider:SetValue(Auto.SavedFaceSensitivity)
                Auto.FaceSensitivity = Auto.SavedFaceSensitivity
            end
            Auto.IsUpdatingSlider = false
        end
    end
})
