task.spawn(function()
    local function applyScrollFix(scrollingFrame)
        if not scrollingFrame or not scrollingFrame:IsA("ScrollingFrame") then return end
        scrollingFrame.ScrollingEnabled = true
        scrollingFrame.ElasticBehavior = Enum.ElasticBehavior.Always
        scrollingFrame.ScrollingDirection = Enum.ScrollingDirection.Y
        scrollingFrame.Selectable = false

        for _, child in ipairs(scrollingFrame:GetDescendants()) do
            if child:IsA("Frame") and not child:IsA("ScrollingFrame") and not child:FindFirstChildWhichIsA("GuiButton") then
                child.Active = false
            end
        end
        scrollingFrame.DescendantAdded:Connect(function(child)
            if child:IsA("Frame") and not child:IsA("ScrollingFrame") and not child:FindFirstChildWhichIsA("GuiButton") then
                child.Active = false
            end
        end)
    end

    task.wait(0.8)
    pcall(function()
        for _, tab in pairs(Tabs) do
            if type(tab) == "table" then
                if tab.LeftSide and tab.LeftSide:IsA("ScrollingFrame") then
                    applyScrollFix(tab.LeftSide)
                end
                if tab.RightSide and tab.RightSide:IsA("ScrollingFrame") then
                    applyScrollFix(tab.RightSide)
                end
            end
        end
    end)
end)

