    Text = "Distance",
    Default = 15,
    Min = 5,
    Max = 20,
    Rounding = 0,
    Callback = function(v)
        if not Auto.IsUpdatingSlider then
            Auto.ParryDistance = v
            if not Auto.AggressiveParry then Auto.SavedDistance = v end
        end
    end
})
FaceSensitivitySlider = ParryBox:AddSlider("FaceSensitivity", {
    Text = "Face Sensitivity Killer",
