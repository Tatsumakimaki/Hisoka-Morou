            and Remotes.Killers:FindFirstChild("Stalker", true)
            and Remotes.Killers.Stalker:FindFirstChild("StartStalking")
        if stalkEvent then
            pcall(function() stalkEvent:FireServer(target) end)
        end
    end)
end

