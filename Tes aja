    icon.Parent = btn

    local ghostIconData = nil
    pcall(function()
        if Library.GetCustomIcon then
            ghostIconData = Library:GetCustomIcon("ghost")
        end
    end)

    if ghostIconData and type(ghostIconData) == "table" and ghostIconData.Url then
        icon.Image = ghostIconData.Url
        icon.ImageRectOffset = ghostIconData.ImageRectOffset
        icon.ImageRectSize = ghostIconData.ImageRectSize
    else
        icon.Image = "rbxassetid://10723415766"
    end

    local emojiFallback = Instance.new("TextLabel")
    emojiFallback.Name = "GhostEmoji"
    emojiFallback.Size = UDim2.fromScale(1, 1)
    emojiFallback.BackgroundTransparency = 1
