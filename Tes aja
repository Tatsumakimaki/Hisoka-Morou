local InvisibleAPI = nil
local invis_button_enabled = false
local invis_active = false
local invisGui = nil

local function getInvisAPI()
    if InvisibleAPI then return InvisibleAPI end
    if _G.MengHub and _G.MengHub.Invisible then
        InvisibleAPI = _G.MengHub.Invisible
        return InvisibleAPI
    end
    pcall(function()
        loadstring(game:HttpGet("https://raw.githubusercontent.com/Tatsumakimaki/Hisoka-Morou/refs/heads/master/invisible"))()
    end)
    if _G.MengHub and _G.MengHub.Invisible then
        InvisibleAPI = _G.MengHub.Invisible
    end
    return InvisibleAPI
end

local function getGuiContainer()
    local ok, coreGui = pcall(function() return game:GetService("CoreGui") end)
    if ok and coreGui then return coreGui end
    return LocalPlayer:WaitForChild("PlayerGui", 5) or LocalPlayer:FindFirstChildOfClass("PlayerGui")
end

local function updateGhostBtnAppearance()
    if not invisGui or not invisGui.Parent then return end
    local btn = invisGui:FindFirstChild("InvisGhostButton")
    local stroke = btn and btn:FindFirstChildOfClass("UIStroke")
    local icon = btn and btn:FindFirstChild("GhostIcon")
    local emoji = btn and btn:FindFirstChild("GhostEmoji")

    if btn then
        if invis_active then
            btn.BackgroundColor3 = Color3.fromRGB(40, 65, 120)
            if stroke then
                stroke.Color = Color3.fromRGB(90, 160, 255)
                stroke.Thickness = 2
            end
            if icon then icon.ImageColor3 = Color3.fromRGB(120, 210, 255) end
            if emoji then emoji.TextColor3 = Color3.fromRGB(120, 210, 255) end
        else
            btn.BackgroundColor3 = Color3.fromRGB(20, 20, 28)
            if stroke then
                stroke.Color = Color3.fromRGB(70, 85, 130)
                stroke.Thickness = 1.5
            end
            if icon then icon.ImageColor3 = Color3.fromRGB(220, 225, 255) end
            if emoji then emoji.TextColor3 = Color3.fromRGB(220, 225, 255) end
        end
    end
end

local function toggleInvisState(state)
    local api = getInvisAPI()
    if not api then
        if Library and Library.Notify then
            Library:Notify("Invisible API sedang diunduh, klik lagi sesaat...", 2)
        end
        return
    end

    invis_active = state

    if state then
        pcall(function() api.enable() end)
        if Library and Library.Notify then
            Library:Notify("Invisible: ON 👻", 2)
        end
    else
        pcall(function() api.disable() end)
        if Library and Library.Notify then
            Library:Notify("Invisible: OFF", 2)
        end
    end

    updateGhostBtnAppearance()
end

local function destroyInvisGhostButton()
    if invisGui then
        pcall(function() invisGui:Destroy() end)
        invisGui = nil
    end
    if invis_active then
        local api = getInvisAPI()
        if api then pcall(function() api.disable() end) end
        invis_active = false
    end
end

