    local function AP3DisableOtherParries()
        -- Match the  behavior of avoiding simultaneous V1/V2 engines.
        for _, key in ipairs({ "REAPER_AP1_Enabled", "AP_V2_Enabled", "SURV_AutoParryV3" }) do
            VD[key] = false
