    local function ToF_ArcDisp(vel, omega, T)
        local N = 6
        local dt = T / N
        local rot = CFrame.Angles(0, omega * dt, 0)
        local pos, dir = Vector3.zero, vel
        for _ = 1, N do
            pos = pos + dir * dt
            dir = rot:VectorToWorldSpace(dir)
        end
        return pos
    end
    local function ToF_ConfEff(S)
        if math.abs(S.omega or 0) > 0.35 then return math.max(S.conf, 0.6) end
        return S.conf
    end
    local ToF_SnapBuf = {}
    task.spawn(function()
        local r = ReplicatedStorage:WaitForChild("Remotes", 15)
        r = r and r:WaitForChild("Mechanics", 15)
        r = r and r:WaitForChild("NetRemote", 15)
        if not r then return end
        r.OnClientEvent:Connect(function(pkt)
            if not VD.TOFV3SRC_SilentAim then return end
            if type(pkt) ~= "table" or pkt.kind ~= "Snapshot" then return end
            local dd = pkt.data
            if type(dd) ~= "table" or type(dd.players) ~= "table" or type(dd.t) ~= "number" then return end
            local nowc = os.clock()
            for _, pe in pairs(dd.players) do
                if type(pe) == "table" and typeof(pe.pos) == "Vector3" and type(pe.id) == "number" then
                    local e = ToF_SnapBuf[pe.id]
                    if not e then e = { s = {} }; ToF_SnapBuf[pe.id] = e end
                    local sb = e.s
                    local last = sb[#sb]
                    if not last or dd.t > last.ts then
                        if last and (pe.pos - last.pos).Magnitude / math.max(dd.t - last.ts, 0.001) > 250 then
                            e.s = {}; sb = e.s
                        end
                        sb[#sb + 1] = { ts = dd.t, pos = pe.pos, tl = nowc }
                        while #sb > 24 do table.remove(sb, 1) end
                    end
                end
            end
        end)
    end)
    local function ToF_GetSnap(char)
        local pl = char and Players:GetPlayerFromCharacter(char)
        local e = pl and ToF_SnapBuf[pl.UserId]
        if not e then return nil end
        local sb = e.s
        local n = #sb
        if n < 3 then return nil end
        local last = sb[n]
        if os.clock() - last.tl > 0.4 then return nil end
        local function seg(t0, t1)
            local a, b
            for i = 1, n do
                local x = sb[i]
                local age = last.ts - x.ts
                if age >= t0 and age <= t1 then
                    if not a then a = x end
                    b = x
                end
            end
            if a and b and b.ts - a.ts >= 0.07 then
                local v = (b.pos - a.pos) / (b.ts - a.ts)
                return Vector3.new(v.X, 0, v.Z), v.Y
            end
        end
        local w0, vy = seg(0, 0.15)
        if not w0 then return nil end
        local vNow = seg(0, 0.1)
        local vs = vNow or w0
        if vs.Magnitude < 1 then vs = Vector3.zero end
        local w1 = seg(0.15, 0.3)
        local w2 = seg(0.3, 0.45)
        local conf, omega = 1, 0
        local function turn(a, b)
            if not (a and b) or a.Magnitude < 2 or b.Magnitude < 2 then return nil end
            local phi = math.atan2(a.Z, a.X) - math.atan2(b.Z, b.X)
            if phi > math.pi then phi = phi - 2 * math.pi elseif phi < -math.pi then phi = phi + 2 * math.pi end
            return phi
        end
        local flips = 0
        if w0 and w1 and w0.Magnitude > 2 and w1.Magnitude > 2 and w0.Unit:Dot(w1.Unit) < 0.2 then flips = flips + 1 end
        if w1 and w2 and w1.Magnitude > 2 and w2.Magnitude > 2 and w1.Unit:Dot(w2.Unit) < 0.2 then flips = flips + 1 end
        if flips >= 2 then
            local net = seg(0, 0.45)
            vs = net or Vector3.zero
            if vs.Magnitude < 1.5 then vs = Vector3.zero end
            return { pos = last.pos, tl = last.tl, vel = vs, vy = vy or 0, conf = 0.6, omega = 0 }
        end
        local p1, p2 = turn(w1, w0), turn(w2, w1)
        if p1 and p2 and math.abs(p1) > 0.08 and math.abs(p2) > 0.08 then
            if p1 * p2 > 0 then
                omega = math.clamp((p1 + p2) / 2 / 0.15, -8, 8)
            else
                conf = 0.5
            end
        end
        return { pos = last.pos, tl = last.tl, vel = vs, vy = vy or 0, conf = conf, omega = omega }
    end

    local function ToF_SampleVel(char)
        local root = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso"))
        if not (root and root:IsA("BasePart")) then return end
        local S = ToF_Track[char]
        if not S then
            S = { s = {}, pend = {}, mAuto = 1, conf = 1, omega = 0, vShort = Vector3.zero, lead = Vector3.zero, leadT = 0, lastPend = 0 }
            ToF_Track[char] = S
        end
        local now, pos = os.clock(), root.Position
        local s = S.s
        local last = s[#s]
        if last then
            if now - last.t < 0.004 then return end
            if (pos - last.pos).Magnitude / (now - last.t) > 200 then
                S.s = {}; S.pend = {}; S.lead = Vector3.zero; s = S.s
            end
        end
        s[#s + 1] = { t = now, pos = pos }
        while #s > 2 and now - s[1].t > 0.45 do table.remove(s, 1) end

        local function seg(t0, t1)
            local a, b
            for i = 1, #s do
                local e = s[i]
                if e.t >= now - t1 and e.t <= now - t0 then
                    if not a then a = e end
                    b = e
                end
            end
            if a and b and b.t - a.t >= 0.04 then
                local v = (b.pos - a.pos) / (b.t - a.t)
                return Vector3.new(v.X, 0, v.Z), v.Y
            end
        end
        local vs, vy = seg(0, 0.15)
        vs = vs or Vector3.zero
        S.vy = vy or 0
        if vs.Magnitude < 1 then vs = Vector3.zero end
        local vl = seg(0.15, 0.4)
        local conf = 1
        if vl and vs.Magnitude > 1 and vl.Magnitude > 1 then
            conf = math.clamp(vs.Unit:Dot(vl.Unit), 0.25, 1)
        end
        S.vShort, S.conf = vs, conf
        if vl and vs.Magnitude > 2 and vl.Magnitude > 2 then
            local phi = math.atan2(vl.Z, vl.X) - math.atan2(vs.Z, vs.X)
            if phi > math.pi then phi = phi - 2 * math.pi elseif phi < -math.pi then phi = phi + 2 * math.pi end
            S.omega = S.omega * 0.5 + math.clamp(phi / 0.2, -8, 8) * 0.5
        else
            S.omega = S.omega * 0.8
        end

        S.vIn, S.stopping, S.air = nil, false, false
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            local md = hum.MoveDirection
            local mdh = Vector3.new(md.X, 0, md.Z)
            if mdh.Magnitude > 0.1 then
                if not S.hadInput then S.inT0 = now; S.holdT0 = now end
                local dirNow = mdh.Unit
                if S.inDir and S.inDir:Dot(dirNow) < 0.9 then S.inT0 = now end
                S.inDir = dirNow
                S.hadInput = true
                local wsNow = hum.WalkSpeed
                if wsNow > 0 and (now - (S.holdT0 or now)) > 0.15 and vs.Magnitude < 0.3 * wsNow then
                    if not S.blocked then S.blocked = true; S.blockDir = dirNow end
                elseif wsNow > 0 and vs.Magnitude >= 0.5 * wsNow then
                    S.blocked = false
                end
                if vs.Magnitude > 2 then S.mdWorks = true end
                if vs.Magnitude > 2 then
                    S.vIn = mdh.Unit * vs.Magnitude
                elseif hum.WalkSpeed > 0 then
                    S.vIn = mdh.Unit * hum.WalkSpeed * 0.6
                end
            else
                S.hadInput = false
                S.blocked, S.inDir = false, nil
                if S.mdWorks then S.stopping = true end
            end
            local okf, fm = pcall(function() return hum.FloorMaterial end)
            S.air = okf and fm == Enum.Material.Air
        end

        local pend = S.pend
        if VD.TOFV3SRC_SmartPredict then
            if vs.Magnitude > 2 and conf > 0.7 and now - S.lastPend > 0.06 and #pend < 24 then
                local tau = ToF_Delay()
                S.lastPend = now
                pend[#pend + 1] = { due = now + tau, base = pos, vl = vs * tau }
            end
            local i = 1
            while i <= #pend do
                local pd = pend[i]
                if now >= pd.due then
                    local disp = pos - pd.base
                    disp = Vector3.new(disp.X, 0, disp.Z)
                    local den = pd.vl:Dot(pd.vl)
                    if den > 1 then
                        local m = math.clamp(disp:Dot(pd.vl) / den, 0, 2.5)
                        S.mAuto = S.mAuto + (m - S.mAuto) * 0.12
                    end
                    table.remove(pend, i)
                else
                    i = i + 1
                end
            end
        elseif #pend > 0 then
            S.pend = {}
        end
    end

    local ToF_MUZZLE = Vector3.new(0.70, 1.37, -2.50)
    local function ToF_Muzzle(hrp, face)
        local pos = hrp.Position
        local cf = hrp.CFrame
        if face then
            local fl = Vector3.new(face.X - pos.X, 0, face.Z - pos.Z)
            if fl.Magnitude > 0.5 then cf = CFrame.lookAt(pos, pos + fl) end
        end
        return cf:PointToWorldSpace(ToF_MUZZLE)
    end

    local function ToF_TargetWithinLimits(targetPart, originPos)
        if not (targetPart and targetPart.Parent) then return false end
        local maxDistance = math.max(tonumber(VD.TOFV3SRC_MaxDistance) or 500, 1)
        local distOrigin = typeof(originPos) == "Vector3" and originPos or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character.HumanoidRootPart.Position)
        if distOrigin and (targetPart.Position - distOrigin).Magnitude > maxDistance then return false end
        local camera = workspace.CurrentCamera
        if camera then
            local projected, onScreen = camera:WorldToViewportPoint(targetPart.Position)
            if not onScreen then return false end
            local center = Vector2.new(camera.ViewportSize.X * 0.5, camera.ViewportSize.Y * 0.5)
            local screenPos = Vector2.new(projected.X, projected.Y)
            local radius = math.clamp(tonumber(VD.TOFV3SRC_FOV) or 250, 10, 1200)
            if (screenPos - center).Magnitude > radius then return false end
        end
        return true
    end

    local function ToF_GetTarget()
        local g = ToF_GetGun(); local c = LocalPlayer.Character
        if not (g and c) then return nil,nil,nil,nil end
        local hrp = c:FindFirstChild("HumanoidRootPart")
        if not hrp then return nil,nil,nil,nil end
        local mp = hrp.Position
        local op
        if c:GetAttribute("IsCarried") then op = hrp.Position + (hrp.CFrame.LookVector * 2)
        else
            op = ToF_Muzzle(hrp)
        end
        local function predict(t, tc)
            local tp = t.Position
            if not ToF_TargetWithinLimits(t, op) then return nil,nil,nil,nil end
            if VD.TOFV3SRC_WallCheck and not ToF_IsVisible(op, tp, tc) then return nil,nil,nil,nil end
            local rp = tc and (tc:FindFirstChild("HumanoidRootPart") or t)
            local dr = tp - op; local d = dr.Magnitude
            if d < 0.1 then return nil,nil,nil,nil end
            if d < 5 then
                ToF_LastPred = nil
                local op2 = c:GetAttribute("IsCarried") and op or ToF_Muzzle(hrp, tp)
                local dr2 = tp - op2
                if dr2.Magnitude < 0.1 then return nil,nil,nil,nil end
                return dr2.Unit, g, op2, tp
            end
            local aimPos = tp
            ToF_LastReal = nil
            if VD.TOFV3SRC_AutoPredict and tc then
                ToF_SampleVel(tc)
                local S = ToF_Track[tc]
                local SN = VD.TOFV3SRC_UseSnap and ToF_GetSnap(tc) or nil
                local hrpR = tc:FindFirstChild("HumanoidRootPart")
                if SN and (not hrpR or (SN.pos - hrpR.Position).Magnitude > 50) then SN = nil end
                if S and SN then
                    S.vShort, S.vy, S.omega, S.conf = SN.vel, SN.vy, SN.omega, SN.conf
                end
                local vel = S and S.vShort or Vector3.zero
                local nowc = os.clock()
                if S then
                    if S.vIn then
                        local startingUp = S.inT0 and (nowc - S.inT0) < 0.25
                        local exiting = S.blocked and S.blockDir and S.vIn.Magnitude > 0.1
                            and S.vIn.Unit:Dot(S.blockDir) < 0.85
                        if exiting then
                            vel = S.vIn.Unit * math.max(vel.Magnitude, (S.vIn.Magnitude) * 0.8)
                        elseif startingUp or vel.Magnitude >= 0.5 * S.vIn.Magnitude then
                            vel = vel:Lerp(S.vIn, startingUp and 0.6 or 0.5)
                        end
                    elseif S.stopping then
                        vel = vel * 0.3
                    end
                end
                local vy = S and S.vy or 0
                if S and (vel.Magnitude > 1 or (S.air and math.abs(vy) > 1)) then
                    local ping = ToF_Ping()
                    local mult
                    if VD.TOFV3SRC_SmartPredict then
                        mult = math.clamp(math.clamp(S.mAuto, 0.2, 1.8) * ToF_ConfEff(S) * (tonumber(VD["TOFV3SRC_HitGain" .. ToF_Band(d)]) or 1), 0.3, 1.6)
                    else
                        mult = tonumber(VD.TOFV3SRC_LeadMultiplier) or 1.4
                    end
                    local base = ToF_Delay()
                    local vb = math.max(tonumber(VD.TOFV3SRC_BulletSpeed) or 200, 50)
                    local kT = VD.TOFV3SRC_UseTravel and math.clamp(tonumber(VD.TOFV3SRC_TravelK) or 0.5, 0, 2.5) or 0
                    local om = S.omega or 0
                    local ex, snapOff, realBase = 0, Vector3.zero, tp
                    if SN then
                        ex = math.clamp(os.clock() - SN.tl, 0, 0.15)
                        local off = hrpR and (tp - hrpR.Position) or Vector3.zero
                        realBase = SN.pos + off
                        snapOff = realBase - tp
                    end
                    local function leadFor(dl0)
                        local dl = dl0 + ex
                        local ld = vel * dl * mult
                        if vel.Magnitude > 2 and math.abs(om) > 0.35 then
                            local lim = math.rad(100) / math.max(dl, 0.05)
                            local omE = math.clamp(om * 0.7, -lim, lim)
                            ld = ToF_ArcDisp(vel, omE, dl) * mult
                        end
                        local cap = math.clamp(math.max(d * 0.6, vel.Magnitude * dl * mult * 1.2), 3, 120)
                        if ld.Magnitude > cap then ld = ld.Unit * cap end
                        return ld
                    end
                    local delay = base + kT * d / vb
                    local lead = leadFor(delay)
                    if kT > 0 then
                        for _ = 1, 2 do
                            delay = base + kT * (tp + lead - op).Magnitude / vb
                            lead = leadFor(delay)
                        end
                    end
                    local dy = 0
                    if S.air then
                        dy = vy * delay - 0.5 * workspace.Gravity * delay * delay
                        local okr, hit = pcall(function()
                            local rp2 = RaycastParams.new()
                            rp2.FilterType = Enum.RaycastFilterType.Exclude
                            rp2.FilterDescendantsInstances = { tc, LocalPlayer.Character }
                            return workspace:Raycast(tp, Vector3.new(0, -300, 0), rp2)
                        end)
                        if okr and hit then
                            dy = math.max(dy, -((tp.Y - hit.Position.Y) - 1))
                        end
                        dy = math.clamp(dy, -40, 25)
                    end
                    local lh = Vector3.new(lead.X, 0, lead.Z)
                    if lh.Magnitude > 1.5 then
                        local okw, wh = pcall(function()
                            local rp3 = RaycastParams.new()
                            rp3.FilterType = Enum.RaycastFilterType.Exclude
                            rp3.RespectCanCollide = true
                            local ex2 = { tc, LocalPlayer.Character }
                            for _, pl2 in ipairs(Players:GetPlayers()) do
                                if pl2.Character then ex2[#ex2 + 1] = pl2.Character end
                            end
                            rp3.FilterDescendantsInstances = ex2
                            return workspace:Raycast(realBase, lh, rp3)
                        end)
                        if okw and wh then
                            local wd = math.max((wh.Position - realBase).Magnitude - 1.2, 0)
                            lead = lh.Unit * math.min(wd, lh.Magnitude) + Vector3.new(0, lead.Y, 0)
                        end
                    end
                    lead = lead + snapOff
                    lead = Vector3.new(lead.X, dy + snapOff.Y, lead.Z)
                    ToF_LastReal = realBase
                    ToF_LastVel, ToF_LastMult, ToF_LastBase, ToF_LastVB = vel, mult, base, vb
                    local dt = math.clamp(nowc - S.leadT, 0, 0.2)
                    S.leadT = nowc
                    local sm = math.clamp((tonumber(VD.TOFV3SRC_LineSmooth) or 70) / 100, 0, 1)
                    local rate = 80 * (1 - sm) + 8 * sm
                    S.lead = S.lead:Lerp(lead, math.clamp(dt * rate, 0.05, 1))
                    aimPos = tp + (ToF_RawMode and lead or S.lead)
                elseif S then
                    S.lead = Vector3.zero; S.leadT = nowc
                end
            end
            local opF = c:GetAttribute("IsCarried") and op or ToF_Muzzle(hrp, aimPos)
            local fd = aimPos - opF
            if fd.Magnitude < 0.1 then return nil,nil,nil,nil end
            ToF_LastPred = { tc = tc, real = ToF_LastReal or tp, aim = aimPos, band = ToF_Band(d), vel = ToF_LastVel, mult = ToF_LastMult, base = ToF_LastBase, d = d, vb = ToF_LastVB }
            return fd.Unit, g, opF, aimPos
        end
        local mode = VD.TOFV3SRC_TargetMode or "Killer"
        if mode=="Killer" then
            local bt, bc, bs = nil, nil, math.huge
            for _,p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and TeamIs(p, "Killer") and p.Character then
                    local t = p.Character:FindFirstChild("Torso")
                        or p.Character:FindFirstChild("UpperTorso")
                        or p.Character:FindFirstChild("HumanoidRootPart")
                    if t and ToF_TargetWithinLimits(t, mp) then
                        local d = (mp-t.Position).Magnitude
                        if d < bs then bs=d; bt=t; bc=p.Character end
                    end
                end
            end
            if not bt then return nil,nil,nil,nil end
            return predict(bt, bc)
        elseif mode=="Survivors" then
            local bt, bc, bd = nil, nil, -math.huge
            local cam = workspace.CurrentCamera
            local cl = cam.CFrame.LookVector
            for _,p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and TeamIs(p, "Survivor") and p.Character then
                    local t = p.Character:FindFirstChild("Torso")
                        or p.Character:FindFirstChild("UpperTorso")
                        or p.Character:FindFirstChild("HumanoidRootPart")
                    if t and ToF_TargetWithinLimits(t, mp) then
                        local dt = t.Position - cam.CFrame.Position
                        if dt.Magnitude>0.1 then
                            local dot = cl:Dot(dt.Unit)
                            if dot>0.5 and dot>bd then bd=dot; bt=t; bc=p.Character end
                        end
                    end
                end
            end
            if not bt then return nil,nil,nil,nil end
            return predict(bt, bc)
        elseif mode=="Zombie" then
            local bp, bd = nil, -math.huge
            local cam = workspace.CurrentCamera
            local cl = cam.CFrame.LookVector
            for _,r in ipairs(ToF_GetSCPs()) do
                if r and r.Parent and ToF_TargetWithinLimits(r, mp) then
                    local dt = r.Position - cam.CFrame.Position
                    if dt.Magnitude>0.1 then
                        local dot = cl:Dot(dt.Unit)
                        if dot>0.5 and dot>bd then bd=dot; bp=r end
                    end
                end
            end
            if not bp then return nil,nil,nil,nil end
            return predict(bp, bp.Parent)
        end
        return nil,nil,nil,nil
    end
