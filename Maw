            -- Anti Hook: periodically sends the game's character-look update while carried.
            local antiHookAccumulator = 0
            local function FindAntiHookRemote()
                local remotes = ReplicatedStorage:FindFirstChild("Remotes")
                local gameRemotes = remotes and remotes:FindFirstChild("Game")
                local remote = gameRemotes and gameRemotes:FindFirstChild("UpdateCharacterLook")
                if remote and remote:IsA("RemoteEvent") then return remote end
                -- Allow for builds where the same remote is nested differently.
                remote = remotes and remotes:FindFirstChild("UpdateCharacterLook", true)
                if remote and remote:IsA("RemoteEvent") then return remote end
                return nil
            end
            local function IsAntiHookCarryState(character)
                if not character then return false end
                for _, attributeName in ipairs({ "IsCarried", "isCarried", "Carried", "IsHooked", "isHooked", "Hooked" }) do
                    if character:GetAttribute(attributeName) == true then return true end
                end
                return false
            end
            RunService.Heartbeat:Connect(function(deltaTime)
                if not VD.AntiHookEnabled then antiHookAccumulator = 0; return end
                local character = LocalPlayer.Character
                if not character or not IsAntiHookCarryState(character) then
                    antiHookAccumulator = 0
                    return
                end
                local hz = math.clamp(tonumber(VD.AntiHookHz) or 44, 1, 60)
                local interval = 1 / hz
                antiHookAccumulator = math.min(antiHookAccumulator + deltaTime, interval * 3)
                local sends = 0
                while antiHookAccumulator >= interval and sends < 3 do
                    antiHookAccumulator = antiHookAccumulator - interval
                    sends = sends + 1
                    local remote = FindAntiHookRemote()
                    if remote then
                        local normal = CFrame.new(0, 1, 0)
                        local offset = CFrame.new(0, -(tonumber(VD.AntiHookOffset) or 250), 0)
                        pcall(function() remote:FireServer(normal, offset, offset, offset, offset) end)
                    end
                end
            end)
