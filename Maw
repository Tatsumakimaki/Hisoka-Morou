        local function APV1_BuildKillerTriangle(length, halfWidth)
            APV1_DestroyKillerTriangle()
            local folder = Instance.new("Folder")
            folder.Name = "MAWWW_AutoParryV1_KillerPOV_Triangle"

            local L, W = length, halfWidth
            local vertices = {
                Vector3.new(0, 0, 0),
                Vector3.new(W, 0, -L),
                Vector3.new(-W, 0, -L),
            }
            local edges = {
                {vertices[1], vertices[2]},
                {vertices[2], vertices[3]},
                {vertices[3], vertices[1]},
            }
            local dashes, localCFs = {}, {}
            local dashThickness, dashGapRatio = 0.05, 0.28

            for _, edge in ipairs(edges) do
                local startPos, endPos = edge[1], edge[2]
                local edgeVec = endPos - startPos
                local edgeLen = edgeVec.Magnitude
                if edgeLen > 0.05 then
                    local edgeDir = edgeVec.Unit
                    -- Cap dash count to keep the visual lightweight on mobile.
                    local numDashes = math.clamp(math.floor(edgeLen / 0.8), 6, 15)
                    local slotLen = edgeLen / numDashes
                    local dashLen = slotLen * (1 - dashGapRatio)
                    for i = 1, numDashes do
                        local t = (i - 0.5) / numDashes
                        local midPos = startPos + edgeVec * t
                        local part = Instance.new("Part")
                        part.Name = "KillerPOVDash"
                        part.Anchored = true
                        part.CanCollide = false
                        part.CanTouch = false
                        part.CanQuery = false
                        part.CastShadow = false
                        part.Material = Enum.Material.Neon
                        part.Color = Color3.fromRGB(255, 140, 60)
                        part.Transparency = 0
                        part.Size = Vector3.new(dashThickness, dashThickness, dashLen)
                        part.TopSurface = Enum.SurfaceType.Smooth
                        part.BottomSurface = Enum.SurfaceType.Smooth
                        part.Parent = folder
                        dashes[#dashes + 1] = part
                        localCFs[#localCFs + 1] = CFrame.lookAt(midPos, midPos + edgeDir)
                    end
                end
            end

            folder.Parent = Workspace
            APV1State.KillerTriangleFolder = folder
            APV1State.KillerTriangleDashes = dashes
            APV1State.KillerTriangleLocalCFs = localCFs
            APV1State.KillerTriangleLength = L
            APV1State.KillerTriangleHalfWidth = W
        end

        local function APV1_UpdateKillerTriangle()
            local now = os.clock()
            if now - (APV1State.KillerTriangleLastUpdate or 0) < (1 / 30) then return end
            APV1State.KillerTriangleLastUpdate = now

            if not APV1Config.AutoParryV1 or not APV1Config.AutoParryV1KillerTriangle then
                if APV1State.KillerTriangleFolder then APV1_DestroyKillerTriangle() end
                return
            end

            local myCharacter = LocalPlayer.Character
            local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")
            if not myRoot then
                if APV1State.KillerTriangleFolder then APV1_DestroyKillerTriangle() end
                return
            end

            local length = math.clamp(tonumber(APV1Config.AutoParryV1Radius) or 15, 5, 25)
            local halfWidth = APV1_GetKillerTriangleHalfWidth(length)
            local nearestRoot, nearestDistance = nil, math.huge
            for _, killerPlayer in ipairs(Players:GetPlayers()) do
                if killerPlayer ~= LocalPlayer and killerPlayer.Team and killerPlayer.Team.Name == "Killer" then
                    local killerCharacter = killerPlayer.Character
                    local killerHumanoid = killerCharacter and killerCharacter:FindFirstChildOfClass("Humanoid")
                    local killerRoot = killerCharacter and killerCharacter:FindFirstChild("HumanoidRootPart")
                    if killerRoot and killerHumanoid and killerHumanoid.Health > 0 then
                        local distance = (myRoot.Position - killerRoot.Position).Magnitude
                        if distance <= length and distance < nearestDistance then
                            nearestRoot, nearestDistance = killerRoot, distance
                        end
                    end
                end
            end

            if not nearestRoot then
                if APV1State.KillerTriangleFolder then APV1_DestroyKillerTriangle() end
                return
            end

            if not APV1State.KillerTriangleFolder
                or not APV1State.KillerTriangleFolder.Parent
                or APV1State.KillerTriangleLength ~= length
                or math.abs(APV1State.KillerTriangleHalfWidth - halfWidth) > 0.02 then
                APV1_BuildKillerTriangle(length, halfWidth)
            end

            local look = nearestRoot.CFrame.LookVector
            local flatLook = Vector3.new(look.X, 0, look.Z)
            if flatLook.Magnitude < 0.001 then flatLook = Vector3.new(0, 0, 1) end
            flatLook = flatLook.Unit
            local tipPosition = nearestRoot.Position - Vector3.new(0, 3, 0)
            local baseCF = CFrame.lookAt(tipPosition, tipPosition + flatLook)

            local inside = APV1_IsInsideKillerTriangle(nearestRoot, myRoot, length, halfWidth)
            if APV1Config.AutoParryV1FaceEnabled then
                local threshold = tonumber(APV1Config.AutoParryV1Face) or 0.7
                if threshold < 0.2 then threshold = 0.35 end
                inside = inside and APV1_IsInKillerPOV(nearestRoot, myRoot, threshold)
            end
            local targetColor = inside and Color3.fromRGB(255, 40, 40) or Color3.fromRGB(255, 140, 60)

            local lastCF = APV1State.KillerTriangleLastCF
            local moved = not lastCF or (lastCF.Position - baseCF.Position).Magnitude > 0.02
            if not moved and lastCF then moved = lastCF.LookVector:Dot(baseCF.LookVector) < 0.9995 end
            local colorChanged = APV1State.KillerTriangleLastColor ~= targetColor
            local killerChanged = APV1State.KillerTriangleLastKiller ~= nearestRoot
            if not moved and not colorChanged and not killerChanged then return end

            APV1State.KillerTriangleLastCF = baseCF
            APV1State.KillerTriangleLastColor = targetColor
            APV1State.KillerTriangleLastKiller = nearestRoot
            for i, part in ipairs(APV1State.KillerTriangleDashes) do
                if part and part.Parent then
                    part.CFrame = baseCF * APV1State.KillerTriangleLocalCFs[i]
                    part.Color = targetColor
                end
            end
        end

        -- Remove a stale triangle from an earlier execution before installing this one.
        pcall(function()
