                        ToF_RawMode = false
                        if td and tp and op then
                            local fd = tp - op
                            if fd.Magnitude > 0.1 then
                                newDir = fd.Unit
                                local lp = ToF_LastPred
                                ToF_Shot = { t = os.clock(), tc = lp and lp.tc, real = lp and lp.real, aim = lp and lp.aim, band = lp and lp.band, vel = lp and lp.vel, mult = lp and lp.mult, base = lp and lp.base, d = lp and lp.d, vb = lp and lp.vb, used = false }
                                local c = LocalPlayer.Character
