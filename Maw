        local function AP_ClampLivePanelPosition(panel, x, y)
            local camera = workspace.CurrentCamera
            local viewport = camera and camera.ViewportSize or Vector2.new(360, 720)
            local size = panel and panel.AbsoluteSize or Vector2.new(280, 136)
            if panel and size.X <= 0 then size = Vector2.new(panel.Size.X.Offset, size.Y) end
            if panel and size.Y <= 0 then size = Vector2.new(size.X, panel.Size.Y.Offset) end
            local anchor = panel and panel.AnchorPoint or Vector2.new(0.5, 0)
            local minX = size.X * anchor.X
            local maxX = viewport.X - size.X * (1 - anchor.X)
            if maxX < minX then maxX = minX end
            x = math.clamp(tonumber(x) or viewport.X * 0.5, minX, maxX)
            y = math.clamp(tonumber(y) or 150, 0, math.max(0, viewport.Y - size.Y))
            return x, y
        end

        local function AP_SaveLivePanelPosition(panel)
            local key = AP_LivePanelKey(panel)
            if not key or not panel then return end
            local x, y = AP_ClampLivePanelPosition(panel, panel.Position.X.Offset, panel.Position.Y.Offset)
            panel.Position = UDim2.fromOffset(x, y)
            AP_LivePositions[key] = {X = x, Y = y}
