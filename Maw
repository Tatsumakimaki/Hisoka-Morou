        ping = stat:GetValue() / 1000;
    end);
    return math.clamp(ping, 0, 0.5);
end;

local function VeilV12GetAllTargets()
    local localPlayer = game:GetService("Players").LocalPlayer;
    local localCharacter = localPlayer.Character;
    local localRoot = localCharacter and localCharacter:FindFirstChild("HumanoidRootPart");
    local camera = workspace.CurrentCamera;
    if not localRoot or not camera then return {} end;

    local targets = {};
    local center = Vector2.new(camera.ViewportSize.X * 0.5, camera.ViewportSize.Y * 0.5);
    local closeRange = math.max(0, tonumber(VD.VeilCloseLockRange) or 60);
    local bias = math.max(0, tonumber(VD.VeilDistanceBias) or 0.75);

    for _, player in ipairs(game:GetService("Players"):GetPlayers()) do
        if player ~= localPlayer and player.Team and player.Team.Name == "Survivors" and player.Character then
            local character = player.Character;
            local humanoid = character:FindFirstChildOfClass("Humanoid");
            local part = VeilV12TargetPart(character);
            if humanoid and humanoid.Health > 0 and part then
                local distance3D = (part.Position - localRoot.Position).Magnitude;
                if distance3D <= VD.VeilMaxDist then
                    local screen, onScreen = camera:WorldToViewportPoint(part.Position);
                    local screenPos = Vector2.new(screen.X, screen.Y);
                    local screenDistance = (screenPos - center).Magnitude;
                    local isClose = distance3D <= closeRange;
                    local inFOV = onScreen and screenDistance <= VD.VeilFOV;

                    if inFOV or (not VD.VeilStrictFOV and isClose) then
                        local score = (onScreen and screenDistance or (screenDistance + 2000)) + distance3D * bias;
                        if isClose then score = score - 1500 end;
                        table.insert(targets, {
                            Player = player,
                            Part = part,
                            Distance = distance3D,
                            ScreenPos = screenPos,
                            ScreenDistance = screenDistance,
                            OnScreen = onScreen,
                            IsClose = isClose,
                            Score = score,
                            Humanoid = humanoid
                        });
                    end;
                end;
            end;
        end;
    end;

    table.sort(targets, function(a, b)
        return a.Score < b.Score;
    end);

    return targets;
end;

local function VeilV12ClosestTarget(preferPlayer)
    local targets = VeilV12GetAllTargets();
    local best = targets[1];
    if not best then return nil end;

    local wanted = preferPlayer or (VD.VeilStickyLock and VeilV12State.LockedPlayer or nil);
    if wanted then
        for _, t in ipairs(targets) do
            if t.Player == wanted then
                return t; 

            end;
        end;
    end;
    return best;
end;

local function VeilV12BallisticDirection(startPosition, targetPosition, targetVelocity)
    local speed = math.max(1, tonumber(VD.VeilSpearSpeed) or 165);
    local gravity = VD.VeilAutoGravity and math.max(0, (workspace.Gravity or 196.2) * 0.5) or math.max(0, tonumber(VD.VeilGravity) or 0);
    local lead = VD.VeilAutoPredict and (tonumber(VD.VeilLeadMultiplier) or 1) or 0;
    local predicted = targetPosition;
    local travelTime = (targetPosition - startPosition).Magnitude / speed;
    local direction = (targetPosition - startPosition).Unit;
    for _ = 1, 4 do
        predicted = targetPosition + targetVelocity * travelTime * lead;
        local offset = predicted - startPosition;
        local distance = offset.Magnitude;
        if distance <= VD.VeilCloseRange then
            return offset.Unit, predicted;
        end;
        local horizontal = Vector3.new(offset.X, 0, offset.Z);
        local range = horizontal.Magnitude;
        if range < 0.05 or gravity <= 0 then
            direction = offset.Unit;
        else
            local speedSquared = speed * speed;
            local discriminant = speedSquared * speedSquared - gravity * (gravity * range * range + 2 * offset.Y * speedSquared);
            if discriminant <= 0 then
                direction = offset.Unit;
            else
                local tangent = (speedSquared - math.sqrt(discriminant)) / (gravity * range);
                local cosine = 1 / math.sqrt(1 + tangent * tangent);
                direction = (horizontal.Unit * cosine + Vector3.new(0, tangent * cosine, 0)).Unit;
            end;
        end;
        travelTime = distance / speed;
    end;
    return direction, predicted;
end;

VeilV12StopHoming = function()
    if VeilV12State.HomingThread then
        pcall(task.cancel, VeilV12State.HomingThread);
        VeilV12State.HomingThread = nil;
    end;
    VeilV12State.HomingActive = false;
    VeilV12State.LockedPlayer = nil;
end;

local function VeilV12StartHoming(initialTarget, character, startPosition, initialDirection, launchDistance)
    VeilV12StopHoming();

    local remotes        = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes");
    local mechanics      = remotes and remotes:FindFirstChild("Mechanics");
    local visualizeEvent = mechanics and mechanics:FindFirstChild("visualize");
    local visualizeStop  = mechanics and mechanics:FindFirstChild("visualizeStop");

    if not visualizeEvent or not firesignal then
        return false;
    end;

    local speed     = math.max(1, tonumber(VD.VeilSpearSpeed) or 165);
    local duration  = tonumber(VD.VeilHomingDuration) or 1.4;
    local rate      = math.max(0.02, tonumber(VD.VeilHomingRate) or 0.04);
    local hitDist   = tonumber(VD.VeilHomingHitDist) or 3;

    VeilV12State.HomingActive = true;

    VeilV12State.HomingThread = task.spawn(function()

        local useArc = VD.VeilLongRangeArc and (tonumber(launchDistance) or 0) > (tonumber(VD.VeilArcStartRange) or 65);
        local arcDelay = useArc and math.max(0, tonumber(VD.VeilArcHomingDelay) or 0.18) or 0;
        local launchDirection = initialDirection or workspace.CurrentCamera.CFrame.LookVector;
        if arcDelay > 0 then task.wait(arcDelay) end;

        local startTime   = os.clock();
        local lastTick    = startTime;
        local simPos      = startPosition + launchDirection * speed * arcDelay;
        if useArc then
            local gravity = VD.VeilAutoGravity and math.max(0, (workspace.Gravity or 196.2) * 0.5) or math.max(0, tonumber(VD.VeilGravity) or 0);
            simPos = simPos - Vector3.new(0, 0.5 * gravity * arcDelay * arcDelay, 0);
        end;
        local currentGUID = nil;
        local lastTarget  = initialTarget;

        while VeilV12State.HomingActive and (os.clock() - startTime) < duration do
            local now = os.clock();
            local dt  = math.max(0, now - lastTick);
            lastTick  = now;

            local lockPlayer = (initialTarget and initialTarget.Player) or VeilV12State.LockedPlayer;
            local live = VeilV12ClosestTarget(lockPlayer) or lastTarget;

            if live and live.Part and live.Part.Parent then
                lastTarget = live;
                VeilV12State.LockedPlayer = live.Player;

                local velocity    = VeilV12Velocity(live.Part, live.Player.Name);
                local distance    = (live.Part.Position - simPos).Magnitude;
                local leadTime    = distance / speed + VeilV12Ping() + (tonumber(VD.VeilExtraLeadTime) or 0);
                local predicted   = live.Part.Position + velocity * leadTime * (tonumber(VD.VeilLeadMultiplier) or 1);

                local direction = (predicted - simPos);
                if direction.Magnitude < 0.01 then
                    direction = (live.Part.Position - simPos);
                end;
                direction = direction.Unit;

                if distance <= math.max(4, hitDist * 2) then
                    direction = (live.Part.Position - simPos).Unit;
                end;

                simPos = simPos + direction * speed * dt;

                if currentGUID and visualizeStop then
                    pcall(function()
                        firesignal(visualizeStop.OnClientEvent, currentGUID, simPos);
                    end);
                end;

                local newGUID = VeilV12GenerateGUID();
                pcall(function()
                    firesignal(visualizeEvent.OnClientEvent,
                        character,
                        direction,
                        speed,
                        0.1,
                        newGUID
                    );
                end);

                currentGUID = newGUID;
                VeilV12State.CurrentGUID = newGUID;
                VeilV12State.CurrentTargetPos = predicted;
                VeilV12State.LastPredictedPos = predicted;
                VeilV12State.LastPredictedUntil = now + 0.2;

                if (simPos - live.Part.Position).Magnitude <= hitDist then
                    break;
                end;
            else
                local dir = workspace.CurrentCamera.CFrame.LookVector;
                simPos = simPos + dir * speed * dt;

                if currentGUID and visualizeStop then
                    pcall(function()
                        firesignal(visualizeStop.OnClientEvent, currentGUID, simPos);
                    end);
                end;
                currentGUID = nil;
                break;
            end;

            task.wait(rate);
        end

        if currentGUID and visualizeStop then
            pcall(function()
                firesignal(visualizeStop.OnClientEvent, currentGUID, simPos);
            end);
        end

        VeilV12State.CurrentGUID = nil;
        VeilV12State.CurrentTargetPos = nil;
        VeilV12State.HomingActive = false;
    end);

    return true;
end;

local function VeilV12Fire()
    if not VD.VeilEnabled or VeilV12State.AttackCooldown then return end;

    local localPlayer = game:GetService("Players").LocalPlayer;
    local character   = localPlayer.Character;
    if not character or character:GetAttribute("spearmode") ~= true then return end;
    local currentCamera = workspace.CurrentCamera;
    if not currentCamera then return end;

    VeilV12State.AttackCooldown = true;
    task.delay(0.18, function() VeilV12State.AttackCooldown = false end);

    local startPart = character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart");
    if not startPart then return end;

    local startPosition = startPart.Position;

    VeilV12State.LockedPlayer = nil;
    local target        = VeilV12ClosestTarget();
    local aimDirection  = currentCamera.CFrame.LookVector;
    local targetPosition = nil;

    if target and target.Part then
        VeilV12State.LockedPlayer = target.Player;
        local velocity = VeilV12Velocity(target.Part, target.Player.Name);

        local dist = (target.Part.Position - startPosition).Magnitude;
        local useArc = VD.VeilLongRangeArc and dist > (tonumber(VD.VeilArcStartRange) or 65);

        if VD.VeilDirectAim and not useArc then
            local leadTime = dist / math.max(1, VD.VeilSpearSpeed) + VeilV12Ping() + (tonumber(VD.VeilExtraLeadTime) or 0);
            local predicted = target.Part.Position + velocity * leadTime * (tonumber(VD.VeilLeadMultiplier) or 1);
            if dist <= math.max(4, tonumber(VD.VeilHomingHitDist) or 4) * 2 then
                predicted = target.Part.Position;
            end;
            aimDirection = (predicted - startPosition).Unit;
            VeilV12State.LastPredictedPos = predicted;
        else
            aimDirection, VeilV12State.LastPredictedPos =
                VeilV12BallisticDirection(startPosition, target.Part.Position, velocity);
        end;

        VeilV12State.LastPredictedUntil = os.clock() + 1.25;
        targetPosition = VeilV12State.LastPredictedPos or target.Part.Position;
    else
        VeilV12State.LastPredictedPos   = nil;
        VeilV12State.LastPredictedUntil = 0;
    end;

    local visualizeEvent, visualizeStopEvent;
    pcall(function()
        local remotes   = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes");
        local mechanics = remotes and remotes:FindFirstChild("Mechanics");
        visualizeEvent      = mechanics and mechanics:FindFirstChild("visualize");
        visualizeStopEvent  = mechanics and mechanics:FindFirstChild("visualizeStop");

        if visualizeEvent and firesignal then
            if VeilV12State.CurrentGUID and visualizeStopEvent and VeilV12State.CurrentTargetPos then
                pcall(function()
                    firesignal(visualizeStopEvent.OnClientEvent, VeilV12State.CurrentGUID, VeilV12State.CurrentTargetPos);
                end);
            end;

            local newGUID = VeilV12GenerateGUID();
            VeilV12State.CurrentGUID      = newGUID;
            VeilV12State.CurrentTargetPos = targetPosition or (startPosition + aimDirection * 100);

            firesignal(visualizeEvent.OnClientEvent,
                character,
                aimDirection,
                VD.VeilSpearSpeed,
                0.5,
                newGUID
            );

            task.delay(1.5, function()
                if visualizeStopEvent and VeilV12State.CurrentGUID == newGUID and not VeilV12State.HomingActive then
                    pcall(function()
                        firesignal(visualizeStopEvent.OnClientEvent, newGUID, VeilV12State.CurrentTargetPos);
                    end);
                    VeilV12State.CurrentGUID = nil;
                    VeilV12State.CurrentTargetPos = nil;
                end;
            end);
        end;
    end);

    VeilV12State.SuppressNextThrow = true;
    VeilV12State.SuppressUntil = os.clock() + 0.35;

    pcall(function()
        local remotes    = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes");
        local killers    = remotes and remotes:FindFirstChild("Killers");
        local veil       = killers and killers:FindFirstChild("Veil");
        local spearThrow = veil and veil:FindFirstChild("Spearthrow");
        if spearThrow and spearThrow:IsA("RemoteEvent") then
            spearThrow:FireServer(aimDirection, VD.VeilSpearSpeed, startPosition);
        end
    end);

    task.delay(0.4, function() VeilV12State.SuppressNextThrow = false end);

    if VD.VeilRunToTarget and target and target.Part then
        task.spawn(function()
            VeilV12StartHoming(target, character, startPosition, aimDirection, target.Distance);
        end);
    end;
end;

