            local function StopAutoAttachFollow()
                autoAttachFollowEnabled = false
                local connection = autoAttachFollowConnection
                autoAttachFollowConnection = nil
                if connection then
                    pcall(function() connection:Disconnect() end)
                end
            end

            local function StartAutoAttachFollow()
                local targetPlayer = selectedFollowPlayer and Players:FindFirstChild(selectedFollowPlayer)
                if not targetPlayer or targetPlayer == LocalPlayer then
                    StopAutoAttachFollow()
                    VD_Notify("Auto Attach Player", "Pilih player yang valid terlebih dahulu", 3)
                    return
                end

                StopAutoAttachFollow()
                autoAttachFollowEnabled = true
                autoAttachFollowConnection = RunService.Heartbeat:Connect(function()
                    if not autoAttachFollowEnabled then
                        StopAutoAttachFollow()
                        return
                    end

                    local currentTarget = selectedFollowPlayer and Players:FindFirstChild(selectedFollowPlayer)
                    if not currentTarget or currentTarget == LocalPlayer then return end

                    local targetCharacter = currentTarget.Character
                    local ownCharacter = LocalPlayer.Character
                    if not targetCharacter or not ownCharacter then return end

                    local targetRoot = targetCharacter:FindFirstChild("HumanoidRootPart")
                    local ownRoot = ownCharacter:FindFirstChild("HumanoidRootPart")
                    local targetHumanoid = targetCharacter:FindFirstChildOfClass("Humanoid")
                    local ownHumanoid = ownCharacter:FindFirstChildOfClass("Humanoid")
                    if not targetRoot or not ownRoot then return end
                    if targetHumanoid and targetHumanoid.Health <= 0 then return end
                    if ownHumanoid and ownHumanoid.Health <= 0 then return end

                    -- Keep the selected relative position, but always face the target player.
                    local directionOffset = attachOffsetByDirection[autoAttachFollowDirection] or attachOffsetByDirection["Belakang"]
                    local offsetCFrame = targetRoot.CFrame * CFrame.new(
                        directionOffset.X * autoAttachFollowDistance,
                        0,
                        directionOffset.Z * autoAttachFollowDistance
                    )
                    local desiredPosition = offsetCFrame.Position + Vector3.new(0, autoAttachFollowVertical, 0)
                    -- Aim at the target on the horizontal plane so the character stays upright.
                    local facePosition = Vector3.new(targetRoot.Position.X, desiredPosition.Y, targetRoot.Position.Z)
                    local desiredCFrame = CFrame.lookAt(desiredPosition, facePosition)
                    pcall(function()
                        if ownRoot.Parent and targetRoot.Parent and currentTarget.Character == targetCharacter then
                            ownRoot.CFrame = desiredCFrame
                        end
                    end)
                end)
                VD_Notify("Auto Attach Player", "Mengikuti dari belakang: " .. targetPlayer.Name, 2)
            end

