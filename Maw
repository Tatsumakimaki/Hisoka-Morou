        local function AP_MakeDraggablePanel(panel, dragHandle)
            if not panel or not dragHandle then return end
            dragHandle.Active = true
            local activeInput, startInputPosition, startPanelPosition = nil, nil, nil

            dragHandle.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    activeInput = input
                    startInputPosition = input.Position
                    startPanelPosition = panel.Position
                end
            end)

            local changedConn = UserInputService.InputChanged:Connect(function(input)
                if not activeInput or not panel.Parent then return end
                if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end

                local delta = input.Position - startInputPosition
                local camera = workspace.CurrentCamera
                local viewport = camera and camera.ViewportSize or Vector2.new(360, 720)
                local panelSize = panel.AbsoluteSize
                local x = (startPanelPosition.X.Scale * viewport.X) + startPanelPosition.X.Offset + delta.X
                local y = (startPanelPosition.Y.Scale * viewport.Y) + startPanelPosition.Y.Offset + delta.Y

                -- Keep the draggable status panel inside the screen on both desktop and mobile.
                -- Use the same clamp helper for touch and mouse coordinates.
                x, y = AP_ClampLivePanelPosition(panel, x, y)
                panel.Position = UDim2.fromOffset(x, y)
                AP_SaveLivePanelPosition(panel)
            end)

            local endedConn = UserInputService.InputEnded:Connect(function(input)
                if not activeInput then return end
