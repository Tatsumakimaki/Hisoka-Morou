    local ToF_HookActive = false
    local function ToF_Shoot()
        if not VD.TOFV3SRC_SilentAim then return end
        if ToF_HookActive and not ToF_GameWouldBlock() then return end
        if ToF_IsBlocked() then return end
        local since = os.clock() - (ToFState.LastFaceMove or 0)
        if since < 0.1 then
            pcall(function()
                local c = LocalPlayer.Character
                local hrp = c and c:FindFirstChild("HumanoidRootPart")
                local _, _, _, tp0 = ToF_GetTarget()
                if hrp and tp0 and not c:GetAttribute("IsCarried") then
                    hrp.CFrame = CFrame.new(hrp.Position, Vector3.new(tp0.X, hrp.Position.Y, tp0.Z))
                end
            end)
            task.wait(0.1 - since)
            if not VD.TOFV3SRC_SilentAim or ToF_IsBlocked() then return end
        end
        ToF_RawMode = true
        local okT, td, g, op, tp = pcall(ToF_GetTarget)
        ToF_RawMode = false
        if not (okT and td and g and tp and op) then return end
        local e = ToF_GetEvent()
        if not e then return end
        local fd = tp - op
        if fd.Magnitude < 0.1 then return end
        pcall(function()
            local c = LocalPlayer.Character
            local hrp = c and c:FindFirstChild("HumanoidRootPart")
            if hrp and not c:GetAttribute("IsCarried") then
                hrp.CFrame = CFrame.new(hrp.Position, Vector3.new(tp.X, hrp.Position.Y, tp.Z))
            end
        end)
        local lp = ToF_LastPred
        ToF_Shot = { t = os.clock(), tc = lp and lp.tc, real = lp and lp.real, aim = lp and lp.aim, band = lp and lp.band, vel = lp and lp.vel, mult = lp and lp.mult, base = lp and lp.base, d = lp and lp.d, vb = lp and lp.vb, used = false }
        pcall(function() e:FireServer(g, fd.Unit) end)
    end

    task.spawn(function()
        pcall(function()
            if not ToF_IsCurrentRuntime() then return end
            if typeof(hookmetamethod) ~= "function" or typeof(getnamecallmethod) ~= "function" then return end
            local remote
            for _ = 1, 40 do
                remote = ToF_GetEvent()
                if remote then break end
                task.wait(0.5)
            end
            if not remote then return end
            local oldNC
            oldNC = hookmetamethod(game, "__namecall", function(self, ...)
                local method = getnamecallmethod()
                if ToF_IsCurrentRuntime() and self == remote and method == "FireServer" and type(checkcaller) == "function" and not checkcaller() and VD.TOFV3SRC_SilentAim then
                    local args = table.pack(...)
