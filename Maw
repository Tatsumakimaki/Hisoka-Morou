            local G = W.Graphics
            -- Restore predictable Roblox camera defaults on script reload. A previous Unlimited Zoom
            -- run can leave max zoom at 1000+ and min zoom at 0; do not treat those as defaults.
            local CAMERA_DEFAULT_FOV = 70
            local CAMERA_DEFAULT_MIN_ZOOM = 0.5
