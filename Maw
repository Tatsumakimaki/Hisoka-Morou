        end

        function section:AddToggle(opts)
            opts = opts or {}
            local holder = makeControl(opts.Title or "Toggle", opts.Content)
            local button = new("TextButton", {
                AnchorPoint = Vector2.new(1, 0.5),
                Position = UDim2.new(1, -8, 0.5, 0),
                Size = UDim2.fromOffset(72, 25),
                BackgroundColor3 = COLORS.Panel,
                BorderSizePixel = 0,
                Text = "",
                AutoButtonColor = false,
                ZIndex = 25,
            }, holder)
            corner(button, 8)
            stroke(button, COLORS.Stroke, 1, 0.35)

            local state = opts.Default == true
            local function render()
                button.Text = state and "ON" or "OFF"
                button.TextColor3 = state and COLORS.Green or COLORS.Muted
                button.BackgroundColor3 = state
                    and Color3.fromRGB(20, 65, 52)
                    or COLORS.Panel
            end
            render()

            local function fire()
                pcall(function()
                    if type(opts.Callback) == "function" then opts.Callback(state) end
                end)
            end

            local function setToggleState(v, silent)
                state = (v == true)
                render()
                if not silent then fire() end
            end

            button.Activated:Connect(function()
                setToggleState(not state, false)
            end)

            local control = __n3k_registerConfigControl(opts, button,
                function() return state end,
                setToggleState)
            local syncRegistry = getgenv().__MAWWW_ToggleStateSync
            if type(syncRegistry) ~= "table" then
                syncRegistry = {}
                getgenv().__MAWWW_ToggleStateSync = syncRegistry
            end
            syncRegistry[control] = {
                Set = setToggleState,
                Get = function() return state end,
            }
            return control
        end

        function section:AddButton(opts)
            opts = opts or {}
            local holder = makeControl(opts.Title or "Button", opts.Content)
            local button = new("TextButton", {
                AnchorPoint = Vector2.new(1, 0.5),
                Position = UDim2.new(1, -8, 0.5, 0),
                Size = UDim2.fromOffset(100, 25),
                BackgroundColor3 = COLORS.Blue,
                BorderSizePixel = 0,
                Text = "RUN",
