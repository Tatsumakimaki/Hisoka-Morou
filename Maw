        local function APV1_IsInKillerPOV(killerRoot, survivorRoot, threshold)
            if not killerRoot or not survivorRoot then return false end
            local delta = survivorRoot.Position - killerRoot.Position
            local flatDelta = Vector3.new(delta.X, 0, delta.Z)
            if flatDelta.Magnitude < 0.15 then return true end
            local look = Vector3.new(killerRoot.CFrame.LookVector.X, 0, killerRoot.CFrame.LookVector.Z)
            if look.Magnitude < 0.05 then return false end
            return look.Unit:Dot(flatDelta.Unit) >= (threshold or 0.35)
        end

        -- Geometry copied from APR's Killer POV triangle, kept inside the V1 engine.
        -- The triangle's half-width follows the existing Face Sensitivity setting so
        -- the visual guide and the V1 facing check stay aligned.
        local function APV1_GetKillerTriangleHalfWidth(length)
            local threshold = tonumber(APV1Config.AutoParryV1Face) or 0.7
            if threshold < 0.2 then threshold = 0.35 end
            threshold = math.clamp(threshold, 0.2, 0.99)
            local factor = math.sqrt(math.max(0, 1 - threshold * threshold)) / threshold
            factor = math.clamp(factor, 0.1, 3.0)
            return length * factor
        end

        local function APV1_IsInsideKillerTriangle(killerRoot, survivorRoot, length, halfWidth)
            if not killerRoot or not survivorRoot or not killerRoot.Parent or not survivorRoot.Parent then
                return false
            end
            local L = tonumber(length) or math.clamp(tonumber(APV1Config.AutoParryV1Radius) or 15, 5, 25)
            local W = tonumber(halfWidth) or APV1_GetKillerTriangleHalfWidth(L)
            if L <= 0 or W <= 0 then return false end

            local look = killerRoot.CFrame.LookVector
            local flatLook = Vector3.new(look.X, 0, look.Z)
            if flatLook.Magnitude < 0.001 then return false end
            flatLook = flatLook.Unit

            local delta = survivorRoot.Position - killerRoot.Position
            local flatDelta = Vector3.new(delta.X, 0, delta.Z)
            local localZ = flatDelta:Dot(flatLook)
            local right = Vector3.new(flatLook.Z, 0, -flatLook.X)
            local localX = flatDelta:Dot(right)
            if localZ < 0 or localZ > L then return false end
            local maxX = (localZ / L) * W
            return math.abs(localX) <= maxX
        end

        local function APV1_FaceCheckOk(killerRoot, survivorRoot)
            -- Keep Auto Parry V1's original detection path unchanged. The triangle is
            -- a visual guide only; its rendered length must not block parries that
            -- the existing V1 trigger window intentionally allows outside the radius.
            if not APV1Config.AutoParryV1FaceEnabled then return true end
            local threshold = tonumber(APV1Config.AutoParryV1Face) or 0.7
            if threshold < 0.2 then threshold = 0.35 end
            return APV1_IsInKillerPOV(killerRoot, survivorRoot, threshold)
        end

