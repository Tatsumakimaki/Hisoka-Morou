        function IsKiller(p) return p and p.Team and p.Team.Name == "Killer" end

        function AttachParrySensor(kChar)
            if not kChar or APV1State.Attached[kChar] then return end
            APV1State.Attached[kChar] = true
            local humanoid = kChar:FindFirstChild("Humanoid") or kChar:WaitForChild("Humanoid", 5)
            if not humanoid then APV1State.Attached[kChar] = nil; return end
            local animator = humanoid:FindFirstChildOfClass("Animator") or humanoid:WaitForChild("Animator", 5)
            if not animator then APV1State.Attached[kChar] = nil; return end

            humanoid.ChildAdded:Connect(function(child)
                if child:IsA("Animator") then
                    APV1State.Attached[kChar] = nil
                    AttachParrySensor(kChar)
                end
            end)
            kChar.AncestryChanged:Connect(function(_, parent)
                if not parent then APV1State.Attached[kChar] = nil end
            end)

            animator.AnimationPlayed:Connect(function(track)
                local animId = track.Animation and track.Animation.AnimationId or ""
                local id = animId:match("%d+")
                local skillName = APV1SkillAnimations[id]
                if not skillName then return end

                -- Preserve the hub's existing Auto Crouch Dodge behavior.
                if id == "80411309607666" and VD.AutoCrouch then
                    local myChar = LocalPlayer.Character
                    if not APV1_IsDowned(myChar) then
                        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                        local killerRoot = kChar:FindFirstChild("HumanoidRootPart")
                        if myRoot and killerRoot and (myRoot.Position - killerRoot.Position).Magnitude <= 40 then
                            TriggerCrouch()
                        end
                    end
                    return
                end

                if not APV1Config.AutoParryV1 or APV1State.Cooldown then return end
                if LocalPlayer.Team and LocalPlayer.Team.Name == "Killer" then return end
                if APV1Config.AutoParryV1IgnoredSkills and APV1Config.AutoParryV1IgnoredSkills[skillName] then return end

                local character = LocalPlayer.Character
                if APV1_IsDowned(character) or not APV1_IsSafeToParry(character) then return end
                local myRoot = character and character:FindFirstChild("HumanoidRootPart")
                local killerRoot = kChar:FindFirstChild("HumanoidRootPart")
                if not myRoot or not killerRoot then return end
                local distance = (myRoot.Position - killerRoot.Position).Magnitude
                local radius = math.clamp(tonumber(APV1Config.AutoParryV1Radius) or 15, 5, 25)

                if APV1Config.AutoParryV1Aggressive then
                    if distance > radius + 5 then return end
                    local function aggressiveCheck()
                        if APV1State.Cooldown or APV1_IsDowned(character) then return true end
                        if not myRoot.Parent or not killerRoot.Parent then return true end
                        if (myRoot.Position - killerRoot.Position).Magnitude > 12 or not APV1_FaceCheckOk(killerRoot, myRoot) then
                            return false
                        end
                        APV1_ExecuteParry()
                        return true
                    end
                    if aggressiveCheck() then return end
                    local started = os.clock()
                    local connection
                    connection = RunService.Heartbeat:Connect(function()
                        if os.clock() - started >= 0.85 or aggressiveCheck() then
                            if connection then connection:Disconnect() end
                        end
                    end)
                else
                    local triggerRadius = radius + 2
                    if distance > radius + 6 then return end
                    if distance <= triggerRadius and APV1_FaceCheckOk(killerRoot, myRoot) then
                        APV1_ExecuteParry()
                        return
                    end
                    local started = os.clock()
                    local connection
                    connection = RunService.Heartbeat:Connect(function()
                        if os.clock() - started < 0.28 and not APV1State.Cooldown
                            and myRoot and killerRoot and myRoot.Parent and killerRoot.Parent
                            and not APV1_IsDowned(character) then
                            if (myRoot.Position - killerRoot.Position).Magnitude <= triggerRadius
                                and APV1_FaceCheckOk(killerRoot, myRoot) then
                                APV1_ExecuteParry()
                                if connection then connection:Disconnect() end
                            end
                        else
                            if connection then connection:Disconnect() end
                        end
                    end)
                end
            end)
        end

