    local function AP3GetParryRemote()
        local cached = AP3State.ParryRemote
        if cached and cached.Parent then return cached end
        local now = os.clock()
        if now - (AP3State.LastRemoteLookup or 0) < 0.25 then return nil end
        AP3State.LastRemoteLookup = now

        local function isParryRemote(instance)
            return instance ~= nil
                and string.lower(instance.Name or "") == "parry"
                and (instance:IsA("RemoteEvent") or instance:IsA("RemoteFunction"))
        end

        local remotes = AP3ReplicatedStorage:FindFirstChild("Remotes")
        local items = remotes and remotes:FindFirstChild("Items")
        local dagger = items and (items:FindFirstChild("Parrying Dagger")
            or items:FindFirstChild("Parry Dagger") or items:FindFirstChild("ParryingDagger"))
        local remote = dagger and dagger:FindFirstChild("parry")
        if isParryRemote(remote) then
            AP3State.ParryRemote = remote
            return remote
        end

        -- Some versions nest the actual remote inside the item folder.
        if dagger then
            for _, descendant in ipairs(dagger:GetDescendants()) do
                if isParryRemote(descendant) then
                    AP3State.ParryRemote = descendant
                    return descendant
                end
            end
        end

        -- Fallback is used only when the canonical item remote is absent.
        for _, descendant in ipairs(AP3ReplicatedStorage:GetDescendants()) do
            if isParryRemote(descendant) then
                AP3State.ParryRemote = descendant
                return descendant
            end
        end
        return nil
    end

    local function AP3AttachCooldownListener()
        if AP3State.CooldownConnection then
            local alive = false
            pcall(function() alive = AP3State.CooldownConnection.Connected end)
            if alive then return end
            AP3State.CooldownConnection = nil
        end

        local function findResultRemote()
            local remotes = AP3ReplicatedStorage:FindFirstChild("Remotes")
            local items = remotes and remotes:FindFirstChild("Items")
            local dagger = items and (items:FindFirstChild("Parrying Dagger")
                or items:FindFirstChild("Parry Dagger") or items:FindFirstChild("ParryingDagger"))
            local result = dagger and (dagger:FindFirstChild("parryResult") or dagger:FindFirstChild("ParryResult"))
            if result and result:IsA("RemoteEvent") then return result end
            if dagger then
                for _, descendant in ipairs(dagger:GetDescendants()) do
                    if string.lower(descendant.Name or "") == "parryresult" and descendant:IsA("RemoteEvent") then
                        return descendant
                    end
                end
            end
            return nil
        end

        local resultRemote = findResultRemote()
        if resultRemote then
            AP3State.CooldownConnection = resultRemote.OnClientEvent:Connect(function(result, durationArg)
                if (AP3State.PendingResultUntil or 0) <= 0 then return end
                local now = os.clock()
                local cooldown = tonumber(durationArg)
                if cooldown and cooldown > 5 then cooldown = cooldown / 100 end
                if not cooldown or cooldown <= 0 then
                    cooldown = (result == true) and 0.9 or 0.6
                end
                cooldown = math.clamp(cooldown, 0.1, 2)
                AP3State.CooldownUntil = now + cooldown
                AP3State.PendingResultUntil = 0
            end)
        end
    end

    local function AP3IsKiller(player)
        if not player or player == AP3LocalPlayer then return false end
        if player:GetAttribute("Role") == "Killer" or player:GetAttribute("IsKiller") == true then return true end
        local character = player.Character
        if character and (character:GetAttribute("Role") == "Killer" or character:GetAttribute("IsKiller") == true) then
            return true
        end
        local teamName = player.Team and string.lower(player.Team.Name or "") or ""
        return string.find(teamName, "killer", 1, true) ~= nil
            or string.find(teamName, "slasher", 1, true) ~= nil
            or string.find(teamName, "hunter", 1, true) ~= nil
            or string.find(teamName, "monster", 1, true) ~= nil
    end

    local function AP3IsBlocked(character)
        if not character or not character.Parent then return true end
        local alwaysBlocked = { "Knocked", "isKnocked", "IsHooked", "isHooked", "IsCarried", "isCarried", "Carried" }
        for _, attributeName in ipairs(alwaysBlocked) do
            if character:GetAttribute(attributeName) == true then return true end
        end
        local hum = character:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return true end
        local player = AP3Players:GetPlayerFromCharacter(character)
        if player and player:GetAttribute("IsDead") == true then return true end
        if VD._AP3_Safety == true then
            local interactable = character:FindFirstChild("CheckInterractable")
            if interactable then
                local interactionFlags = { "isVaulting", "isSliding", "isDroppingPallet", "isRepairing", "isHealing", "isUnhooking", "isExiting" }
                for _, attributeName in ipairs(interactionFlags) do
                    if interactable:GetAttribute(attributeName) == true then return true end
                end
            end
        end
        return false
    end

    local function AP3IsIgnored(skillName)
        local ignored = VD._AP3_IgnoreSkills
        if type(ignored) ~= "table" then return false end
        for key, value in pairs(ignored) do
            if (type(key) == "string" and value == true and key == skillName)
                or (type(value) == "string" and value == skillName) then
                return true
            end
        end
        return false
    end

    local function AP3FacingPasses(myRoot, killerRoot)
        if VD._AP3_Aggressive == true or VD._AP3_FacingEnabled ~= true then
            return true
        end
        local toMe = Vector3.new(myRoot.Position.X - killerRoot.Position.X, 0, myRoot.Position.Z - killerRoot.Position.Z)
        local look = Vector3.new(killerRoot.CFrame.LookVector.X, 0, killerRoot.CFrame.LookVector.Z)
        if toMe.Magnitude < 0.001 or look.Magnitude < 0.001 then return true end
        local threshold = math.clamp(tonumber(VD._AP3_Facing) or 0.7, -1, 1)
        return look.Unit:Dot(toMe.Unit) >= threshold
    end

    local function AP3FireParry()
        local now = os.clock()
        if not AP3State.Alive or VD._AP3_Enabled ~= true then return false end
        if now < AP3State.CooldownUntil
            or ((AP3State.PendingResultUntil or 0) > 0 and now < AP3State.PendingResultUntil)
            or now - AP3State.LastParry < 0.24 then
            return false
        end

        -- Resolve and send first. Missing remotes must not consume the track/cooldown.
        local remote = AP3GetParryRemote()
        if not remote then return false end
        local sent = false
        if remote:IsA("RemoteEvent") then
            sent = pcall(function() remote:FireServer() end)
        elseif remote:IsA("RemoteFunction") then
            sent = true
            task.spawn(function()
                pcall(function() remote:InvokeServer() end)
            end)
        end
        if not sent then return false end

        now = os.clock()
        AP3State.LastParry = now
        AP3State.CooldownUntil = now + 0.24
        AP3State.PendingResultUntil = now + 0.65
        return true
    end

    local function AP3HandleAnimationTrack(killerPlayer, track)
        if not AP3State.Alive or VD._AP3_Enabled ~= true or not track then return end
        if AP3State.ProcessedTracks[track] then return end
        if not AP3IsKiller(killerPlayer) then return end
        local animation = track.Animation
        local animationId = animation and tostring(animation.AnimationId or ""):match("%d+")
        local skillName = animationId and AP3Animations[animationId]
        if not skillName or AP3IsIgnored(skillName) then return end

        local myCharacter = AP3LocalPlayer and AP3LocalPlayer.Character
        local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")
        local killerCharacter = killerPlayer.Character
        local killerRoot = killerCharacter and killerCharacter:FindFirstChild("HumanoidRootPart")
        if not myRoot or not killerRoot or AP3IsBlocked(myCharacter) then return end

        local range = math.clamp(tonumber(VD._AP3_Range) or 15, 5, 30)
        if VD._AP3_Aggressive == true then range = math.min(range + 5, 35) end
        local distance = (myRoot.Position - killerRoot.Position).Magnitude
        if distance > range or not AP3FacingPasses(myRoot, killerRoot) then return end

        if AP3FireParry() then
            AP3State.ProcessedTracks[track] = {
                LastPosition = tonumber(track.TimePosition) or 0,
                FiredAt = os.clock(),
                SkillName = skillName,
            }
        end
    end

    local function AP3RefreshKillerSensors()
        local now = os.clock()
        if now - (AP3State.LastSensorRefresh or 0) < 0.25 then return end
        AP3State.LastSensorRefresh = now
        for _, player in ipairs(AP3Players:GetPlayers()) do
            if AP3IsKiller(player) then
                local character = player.Character
                local humanoid = character and character:FindFirstChildOfClass("Humanoid")
                local animator = humanoid and (humanoid:FindFirstChildOfClass("Animator")
                    or humanoid:FindFirstChildWhichIsA("Animator"))
                if animator and not AP3State.AttachedAnimators[animator] then
                    AP3State.AttachedAnimators[animator] = true
                    local ok, connection = pcall(function()
                        return animator.AnimationPlayed:Connect(function(track)
                            -- Event-driven detection catches short attack tracks between heartbeat scans.
                            task.defer(function()
                                pcall(AP3HandleAnimationTrack, player, track)
                            end)
                        end)
                    end)
                    if ok and connection then
                        table.insert(AP3State.EventConnections, connection)
                    else
                        AP3State.AttachedAnimators[animator] = nil
                    end
                end
            end
        end
    end

    local function AP3UpdateCircle(myRoot)
        local shouldShow = VD._AP3_Enabled == true and VD._AP3_ShowCircle == true and myRoot ~= nil
        if not shouldShow then
