                            if track and track.IsPlaying then
                                local trackPosition = tonumber(track.TimePosition) or 0
                                local processed = AP3State.ProcessedTracks[track]

                                -- Tracks can be reused between attacks. Re-arm after a clear
                                -- rewind instead of permanently suppressing later swings.
                                if type(processed) == "table" then
                                    local previousPosition = tonumber(processed.LastPosition)
                                    if previousPosition and previousPosition > 0.30
                                        and trackPosition < math.min(0.25, previousPosition - 0.12) then
                                        AP3State.ProcessedTracks[track] = nil
                                        processed = nil
                                    else
                                        processed.LastPosition = trackPosition
                                    end
                                elseif processed then
                                    -- Migrate any boolean latch to the current track record format.
                                    processed = { LastPosition = trackPosition, FiredAt = now }
                                    AP3State.ProcessedTracks[track] = processed
                                end

                                if not processed then
                                    local animation = track.Animation
                                    local animationId = animation and tostring(animation.AnimationId or ""):match("%d+")
                                    local skillName = animationId and AP3Animations[animationId]
                                    if skillName and not AP3IsIgnored(skillName) then
                                        local distance = (myRoot.Position - killerRoot.Position).Magnitude
                                        if distance <= range and AP3FacingPasses(myRoot, killerRoot) then
                                            -- Do not latch tracks encountered while the cooldown is
                                            -- active. Only record the track if the parry trigger fired.
                                            if AP3FireParry() then
                                                AP3State.ProcessedTracks[track] = {
                                                    LastPosition = trackPosition,
                                                    FiredAt = now,
                                                }
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        for track in pairs(AP3State.ProcessedTracks) do
            local okPlaying, playing = pcall(function() return track.IsPlaying end)
            if not okPlaying or not playing then AP3State.ProcessedTracks[track] = nil end
        end
    end)

    local function AP3Shutdown()
        AP3State.Alive = false
        AP3State.PendingResultUntil = 0
        if AP3State.Connection then
