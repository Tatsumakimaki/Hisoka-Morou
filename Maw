        table.clear(AP3State.EventConnections or {})
        AP3State.AttachedAnimators = setmetatable({}, { __mode = "k" })
        if AP3State.Circle then
            pcall(function() AP3State.Circle:Destroy() end)
            AP3State.Circle = nil
