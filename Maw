        local function PistolV2_GetOrigin(gun, character, root)
            -- Use the weapon's actual origin as in the reference Silent Pistol V1.
            if not (character and root and gun) then return nil end
            if character:GetAttribute("IsCarried") then
                return root.Position + root.CFrame.LookVector * 2
            end
            local origin
            pcall(function()
                if gun:IsA("BasePart") then
                    origin = gun.Position
                else
                    local part = gun:FindFirstChildOfClass("BasePart")
                    if part then origin = part.Position end
                end
            end)
            return origin or Vector3.new(root.Position.X, root.Position.Y + 1.5, root.Position.Z)
        end
        local function PistolV2_IsVisible(origin, targetPosition, targetCharacter)
            local delta = targetPosition - origin
            local distance = delta.Magnitude
            if distance < 0.1 then return true end
            local params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Exclude
            local excluded = {}
            local ownCharacter = LocalPlayer.Character
            if ownCharacter then table.insert(excluded, ownCharacter) end
            if targetCharacter and targetCharacter ~= ownCharacter then table.insert(excluded, targetCharacter) end
            if PistolV2State.Laser then table.insert(excluded, PistolV2State.Laser) end
            params.FilterDescendantsInstances = excluded
            return workspace:Raycast(origin, delta.Unit * distance, params) == nil
        end
        local function PistolV2_GetVelocity(character, targetPart)
            -- Smoothed HumanoidRootPart velocity, matching the reference implementation.
            local root = character and (character:FindFirstChild("HumanoidRootPart") or targetPart)
            if not root or not root:IsA("BasePart") then return Vector3.zero end
            local position, now = root.Position, tick()
            local previous = PistolV2State.VelocityCache[character]
            if previous then
                local dt = now - previous.time
                if dt > 0.001 and dt < 0.1 then
                    local measured = (position - previous.position) / dt
                    local velocity = previous.velocity:Lerp(measured, 0.4)
                    PistolV2State.VelocityCache[character] = { position = position, velocity = velocity, time = now }
                    return velocity
                end
            end
            local velocity = root.Velocity
            PistolV2State.VelocityCache[character] = { position = position, velocity = velocity, time = now }
            return velocity
        end
        local function PistolV2_Intercept(origin, targetPart, targetCharacter)
            -- Quadratic projectile intercept from the reference V1; prediction is skipped at close range.
            local position = targetPart.Position
            local offset = position - origin
            if offset.Magnitude < 8 then return position end

            local velocity = PistolV2_GetVelocity(targetCharacter, targetPart)
            local speed = math.max(tonumber(VD.TOFV2_ProjectileSpeed) or 500, 1)
            local a = velocity:Dot(velocity) - speed * speed
            local b = 2 * offset:Dot(velocity)
            local c = offset:Dot(offset)
            local flightTime

            if math.abs(a) < 0.01 then
                if math.abs(b) > 0.01 then
                    local candidate = -c / b
                    if candidate > 0.001 then flightTime = candidate end
                end
            else
                local discriminant = b * b - 4 * a * c
                if discriminant >= 0 then
                    local root = math.sqrt(discriminant)
                    local t1 = (-b - root) / (2 * a)
                    local t2 = (-b + root) / (2 * a)
                    if t1 > 0.001 then
                        flightTime = t1
                    elseif t2 > 0.001 then
                        flightTime = t2
                    end
                end
            end

            if flightTime then
                local efficiency = math.clamp(tonumber(VD.TOFV2_PredictionEfficiency) or 0.85, 0.1, 1)
                return position + velocity * efficiency * flightTime
            end
            return position
        end
        local function PistolV2_GetSCPs()
            -- Match the reference cache: SCP/corpse models identified by their attributes.
            if tick() - PistolV2State.SCPCacheAt < 0.5 then return PistolV2State.SCPs end
            local output = {}
            local map = workspace:FindFirstChild("Map")
            if map then
                for _, model in ipairs(map:GetDescendants()) do
                    if model:IsA("Model") then
                        local attributes = model:GetAttributes()
                        if model:GetAttribute("CorpseCreated0492") or next(attributes) ~= nil then
                            local root = model:FindFirstChild("HumanoidRootPart")
                            if root and root:IsA("BasePart") then table.insert(output, root) end
                        end
                    end
                end
            end
            PistolV2State.SCPs, PistolV2State.SCPCacheAt = output, tick()
            return output
        end
        local function PistolV2_GetTarget()
            -- Reference V1 target selection and ToF.Fire payload semantics.
            local character = LocalPlayer.Character
            local root = character and character:FindFirstChild("HumanoidRootPart")
            local gun = PistolV2_GetGun()
            if not (character and root and gun) then return nil, nil, nil, nil end

            local origin = PistolV2_GetOrigin(gun, character, root)
            if not origin then return nil, nil, nil, nil end
            local mode = VD.TOFV2_TargetMode or "Killer"
            local targetPart, targetCharacter
            local camera = workspace.CurrentCamera

            local function getBodyPart(model)
                if not model then return nil end
                -- The source prefers Torso; fallbacks keep this compatible with alternate rigs.
                return model:FindFirstChild("Torso")
                    or model:FindFirstChild("UpperTorso")
                    or model:FindFirstChild("HumanoidRootPart")
            end

            if mode == "Killer" then
                local nearest = math.huge
                for _, player in ipairs(Players:GetPlayers()) do
                    if player ~= LocalPlayer and player.Team and player.Team.Name == "Killer" and player.Character then
                        local part = getBodyPart(player.Character)
                        if part and part:IsA("BasePart") then
                            local distance = (part.Position - root.Position).Magnitude
                            if distance < nearest then
                                nearest, targetPart, targetCharacter = distance, part, player.Character
                            end
                        end
                    end
                end
            elseif mode == "Survivors" then
                if not camera then return nil, nil, nil, nil end
                local look = camera.CFrame.LookVector
                local bestDot = -math.huge
                for _, player in ipairs(Players:GetPlayers()) do
                    if player ~= LocalPlayer and player.Team and player.Team.Name == "Survivors" and player.Character then
                        local part = getBodyPart(player.Character)
                        if part and part:IsA("BasePart") then
                            local delta = part.Position - camera.CFrame.Position
                            if delta.Magnitude > 0.001 then
                                local dot = look:Dot(delta.Unit)
                                if dot > 0.5 and dot > bestDot then
                                    bestDot, targetPart, targetCharacter = dot, part, player.Character
                                end
                            end
                        end
                    end
                end
            elseif mode == "Zombie" then
                if not camera then return nil, nil, nil, nil end
                local look = camera.CFrame.LookVector
                local bestDot = -math.huge
                for _, rootPart in ipairs(PistolV2_GetSCPs()) do
                    local model = rootPart and rootPart.Parent
                    if rootPart and rootPart.Parent then
                        local delta = rootPart.Position - camera.CFrame.Position
                        if delta.Magnitude > 0.001 then
                            local dot = look:Dot(delta.Unit)
                            if dot > 0.5 and dot > bestDot then
                                bestDot, targetPart, targetCharacter = dot, rootPart, model
                            end
                        end
                    end
                end
            end

            if not (targetPart and targetCharacter) then return nil, nil, nil, nil end
            if VD.TOFV2_WallCheck and not PistolV2_IsVisible(origin, targetPart.Position, targetCharacter) then
                return nil, nil, nil, nil
            end

            local targetPosition = targetPart.Position
            if VD.TOFV2_Predict then
                targetPosition = PistolV2_Intercept(origin, targetPart, targetCharacter)
            end
            local direction = targetPosition - origin
            if direction.Magnitude < 0.1 then return nil, nil, nil, nil end
            return direction.Unit, gun, origin, targetPosition
        end
