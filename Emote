-- MIYAKO - EMOTE SYSTEM BACKEND (FIXED & RESPONSIVE)
-- ========================================================
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer

local function getEmoteRemote()
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if remotes then
        -- Diperbaiki: Pendeteksian dibuat spesifik, menghindari salah remote
        return remotes:FindFirstChild("EmoteHandler") 
    end
    return nil
end

_G.Miyako_StopEmote = function()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local animator = hum and hum:FindFirstChildOfClass("Animator")
    if animator then
        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
            pcall(function() track:Stop(0.1) end)
        end
    end
    local remote = getEmoteRemote()
    if remote then pcall(function() remote:FireServer("Stop") end) end
end

_G.Miyako_PlayEmote = function(name)
    if not _G.Miyako_EmoteConfig or not _G.Miyako_EmoteConfig.Enabled then return end
    if not name or name == "" then return end
    
    _G.Miyako_EmoteConfig.LastEmote = name
    local remote = getEmoteRemote()
    if remote then
        pcall(function() remote:FireServer(name) end)
    end
end

_G.Miyako_ReplayEmote = function()
    local target = _G.Miyako_EmoteConfig and (_G.Miyako_EmoteConfig.SelectedEmote or _G.Miyako_EmoteConfig.LastEmote)
    if target then
        if _G.Miyako_StopEmote then _G.Miyako_StopEmote() end
        task.wait(0.1)
        if _G.Miyako_PlayEmote then _G.Miyako_PlayEmote(target) end
    end
end

-- Langsung eksekusi saat dropdown diganti/dipilih
if _G.Miyako_EmoteConfig and _G.Miyako_EmoteConfig.Enabled then
    local emoteToPlay = _G.Miyako_EmoteConfig.SelectedEmote or "Friday Night"
    _G.Miyako_PlayEmote(emoteToPlay)
end
