-- 7. Infinite Hidden (Leap)
BypassKillerBox:AddToggle("InfHidden", {
    Text = "Infinite Hidden (Leap)",
    Default = false,
    Callback = function(v)
        getgenv().BypassLeapEnabled = v
        if v then
            task.spawn(function()
                local leapFunction, m2Function
                for _, fn in pairs(getgc(true)) do
                    if type(fn) == "function" and islclosure(fn) then
                        local info = debug.getinfo(fn)
                        if info.name == "tryActivate" then leapFunction = fn end
                        if info.name == "playM2Animation" then m2Function = fn end
                    end
                end
                while task.wait(0.1) and getgenv().BypassLeapEnabled do
                    for _, fn in pairs({leapFunction, m2Function}) do
                        if fn then
                            for i, val in pairs(debug.getupvalues(fn)) do
                                if type(val) == "boolean" and val == true then
                                    debug.setupvalue(fn, i, false)
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
})

-- 8. Aim Lock Hidden
local Aiming = false
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.UserInputType == Enum.UserInputType.MouseButton2 then Aiming = true end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton2 then Aiming = false end
end)

BypassKillerBox:AddToggle("AimLockHidden", {
    Text = "Aim Lock Hidden",
    Default = false,
    Callback = function(state)
        getgenv().AimLockHiddenEnabled = state
        if state then
            task.spawn(function()
                while getgenv().AimLockHiddenEnabled do
                    if Aiming then
                        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                        if hrp then
                            local closest, shortest = nil, math.huge
                            for _, p in pairs(Players:GetPlayers()) do
                                if p ~= LocalPlayer and p.Character then
                                    local tHrp = p.Character:FindFirstChild("HumanoidRootPart")
                                    if tHrp and p.Team and p.Team.Name == "Survivors" then
                                        local d = (tHrp.Position - hrp.Position).Magnitude
                                        if d < shortest then shortest = d; closest = tHrp end
                                    end
                                end
                            end
                            if closest then
                                pcall(function()
                                    workspace.CurrentCamera.CFrame = CFrame.new(workspace.CurrentCamera.CFrame.Position, closest.Position + Vector3.new(0, 2.5, 0))
                                end)
                            end
                        end
                    end
                    task.wait()
                end
            end)
        else
            Aiming = false
        end
    end
})

