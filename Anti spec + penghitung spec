    Counter = false,
    AntiSpec = false
}

-- Bersihkan instance lama jika script dijalankan ulang
if _G.Miyako_StreamerConn then
    _G.Miyako_StreamerConn:Disconnect()
    _G.Miyako_StreamerConn = nil
end
if _G.Miyako_SpecGui then
    pcall(function() _G.Miyako_SpecGui:Destroy() end)
