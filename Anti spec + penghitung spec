-- Dragging Sistem HUD
local dragging, dragStart, startPos = false, nil, nil
MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

MainFrame.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

-- Fungsi Cek Siapa yang Menonton
local function getSpectators()
    local spectators = {}
    local myChar = LocalPlayer.Character
    local myName = LocalPlayer.Name
    local myDisplay = LocalPlayer.DisplayName

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local isWatching = false
            local target = p:GetAttribute("Spectating") or p:GetAttribute("SpectateTarget") or p:GetAttribute("Target")
            if target and (target == myName or target == myDisplay or (myChar and target == myChar.Name)) then
                isWatching = true
            end

            if not isWatching then
                local specVal = p:FindFirstChild("SpectateTarget") or p:FindFirstChild("Spectating")
                if specVal and (specVal.Value == LocalPlayer or specVal.Value == myName or (myChar and specVal.Value == myChar)) then
                    isWatching = true
                end
            end

            if not isWatching and p:GetAttribute("isspectating") == true then
                local camSub = p:GetAttribute("CameraSubject")
                if camSub and (camSub == myName or (myChar and camSub == myChar.Name)) then
                    isWatching = true
                end
            end

            if isWatching then
                table.insert(spectators, p.DisplayName or p.Name)
            end
        end
    end
    return spectators
end

-- ================= LOGIKA UTAMA (LOOP) =================
local lastCheck = 0
_G.Miyako_StreamerConn = RunService.Heartbeat:Connect(function()
    -- Kontrol Counter Spectator
    if _G.Miyako_StreamerConfig.Counter then
        if not ScreenGui.Enabled then ScreenGui.Enabled = true end
        local now = tick()
        if now - lastCheck >= 0.5 then
            lastCheck = now
            local specs = getSpectators()
            local count = #specs

            CounterText.Text = "Spectators: " .. tostring(count)
            if count > 0 then
                Stroke.Color = Color3.fromRGB(90, 160, 255)
                CounterText.TextColor3 = Color3.fromRGB(120, 210, 255)
                ListFrame.Visible = true

                for _, child in ipairs(ListFrame:GetChildren()) do
                    if child:IsA("TextLabel") then child:Destroy() end
                end

                for _, name in ipairs(specs) do
                    local lbl = Instance.new("TextLabel")
                    lbl.Size = UDim2.new(1, 0, 0, 14)
                    lbl.BackgroundTransparency = 1
                    lbl.Font = Enum.Font.GothamMedium
                    lbl.Text = "• " .. name
                    lbl.TextColor3 = Color3.fromRGB(200, 215, 255)
                    lbl.TextSize = 11
                    lbl.TextXAlignment = Enum.TextXAlignment.Left
                    lbl.Parent = ListFrame
                end
            else
                Stroke.Color = Color3.fromRGB(70, 85, 130)
                CounterText.TextColor3 = Color3.fromRGB(220, 225, 255)
                ListFrame.Visible = false
            end
        end
    else
        if ScreenGui.Enabled then ScreenGui.Enabled = false end
    end

    -- Kontrol Anti Spectate (Blokir player lain agar skip kamera kita)
    local char = LocalPlayer.Character
    if char then
        if _G.Miyako_StreamerConfig.AntiSpec then
            if char:GetAttribute("NoSpectate") ~= true then
                char:SetAttribute("NoSpectate", true)
            end
            if char:GetAttribute("CantSpectate") ~= true then
                char:SetAttribute("CantSpectate", true)
            end
        else
            if char:GetAttribute("NoSpectate") == true then
                char:SetAttribute("NoSpectate", nil)
            end
            if char:GetAttribute("CantSpectate") == true then
                char:SetAttribute("CantSpectate", nil)
            end
        end
    end
end)
